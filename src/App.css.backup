}/* =========================================
   RIDER PROFILE CSS
========================================= */
.rider-profile-card {
  display: flex;
  align-items: center;
  gap: 15px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 15px;
  margin-top: 20px;
}

.rider-avatar {
  font-size: 32px;
}

.rider-info {
  flex: 1;
}

.rider-info strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.rider-info small {
  font-size: 12px;
  color: var(--text);
}

.call-rider-button {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 10px 15px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.dark .rider-profile-card {
  background: var(--bg);
  border: 1px solid var(--border);
}

.dark .rider-info strong {
  color: var(--text-dark);
}

.dark .call-rider-button {
  background: var(--primary);
}/* =========================================
   ORDER HISTORY CSS
========================================= */
.order-history-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.order-history-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.order-history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.order-history-header strong {
  font-size: 16px;
  color: var(--text-dark);
}

.order-history-header small {
  font-size: 12px;
  color: var(--text);
}

.order-history-items {
  margin-bottom: 15px;
}

.history-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

.history-quantity {
  font-weight: 700;
}

.order-history-total {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15px;
}

.order-history-total strong {
  color: var(--primary);
}

.order-history-actions {
  display: flex;
  gap: 10px;
}

.reorder-button {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.remove-order-button {
  background: #fee2e2;
  color: #dc2626;
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.dark .order-history-card {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .order-history-header strong,
.dark .order-history-total strong {
  color: var(--text-dark);
}

.dark .remove-order-button {
  background: #450a0a;
  color: #fecaca;
}

@media (max-width: 600px) {
  .order-history-actions {
    flex-direction: column;
  }
}/* =========================================
   PREMIUM LOGO CSS
========================================= */
.arai-logo-icon {
  position: relative;
  width: 45px;
  height: 45px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  border-radius: 12px;
  overflow: hidden;
}

.logo-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-radius: 12px;
  animation: logoPulse 2s infinite;
}

.logo-main {
  font-size: 22px;
  z-index: 2;
  color: var(--white);
}

.logo-title {
  font-weight: 900;
  font-size: 20px;
  letter-spacing: 1px;
  color: var(--text-dark);
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.logo-subtitle {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2px;
  color: var(--text);
}

@keyframes logoPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.5;
  }
  50% {
    transform: scale(1.2);
    opacity: 0;
  }
}/* =========================================
   PREMIUM LOGIN PAGE (Animated Background)
========================================= */
.premium-login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  position: relative;
  overflow: hidden;
}

.premium-bg-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.4;
}

.circle-one {
  width: 300px;
  height: 300px;
  background: #13a89e;
  top: -50px;
  left: -50px;
  animation: floatCircle 8s infinite;
}

.circle-two {
  width: 400px;
  height: 400px;
  background: #ff6b6b;
  bottom: -100px;
  right: -100px;
  animation: floatCircle 10s infinite;
}

.circle-three {
  width: 200px;
  height: 200px;
  background: #ffd166;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation: floatCircle 12s infinite;
}

@keyframes floatCircle {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(20px, -20px) scale(1.1); }
}

.floating-food {
  position: absolute;
  font-size: 40px;
  z-index: 1;
  animation: floatFood 6s infinite;
}

.food-one { top: 20%; left: 10%; animation-delay: 0s; }
.food-two { top: 70%; right: 10%; animation-delay: 2s; }
.food-three { bottom: 20%; left: 20%; animation-delay: 4s; }
.food-four { top: 40%; right: 30%; animation-delay: 1s; }

@keyframes floatFood {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20px) rotate(10deg); }
}

.premium-login-card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  padding: 40px;
  width: 100%;
  max-width: 420px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  position: relative;
  z-index: 10;
}

.premium-login-logo {
  text-align: center;
  margin-bottom: 30px;
}

.premium-login-logo .premium-logo-icon {
  font-size: 50px;
  display: block;
  margin-bottom: 10px;
}

.premium-login-logo h1 {
  font-size: 32px;
  color: var(--white);
  margin-bottom: 5px;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.premium-login-logo p {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
}

.premium-login-header {
  text-align: center;
  margin-bottom: 25px;
}

.premium-login-header .section-label {
  color: #ffd166;
}

.premium-login-header h2 {
  font-size: 24px;
  color: var(--white);
  margin-bottom: 10px;
}

.premium-login-header p {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
}

.premium-login-card .form-group {
  margin-bottom: 20px;
}

.premium-login-card .form-group label {
  display: block;
  color: var(--white);
  font-weight: 600;
  margin-bottom: 8px;
}

.premium-login-card .form-group input {
  width: 100%;
  padding: 14px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 10px;
  font-size: 14px;
  background: rgba(255, 255, 255, 0.1);
  color: var(--white);
  outline: none;
  transition: all 0.3s;
}

.premium-login-card .form-group input:focus {
  border-color: #13a89e;
  background: rgba(255, 255, 255, 0.2);
}

.premium-login-card .form-group input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.premium-login-card .login-submit-button {
  width: 100%;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  border: none;
  padding: 15px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s;
}

.premium-login-card .login-submit-button:hover {
  opacity: 0.9;
  transform: scale(1.02);
}

.premium-login-card .login-footer {
  margin-top: 20px;
  text-align: center;
}

.premium-login-card .login-footer p {
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 5px;
  font-size: 14px;
}

.premium-login-card .login-footer .signup-link {
  background: transparent;
  border: none;
  color: #ffd166;
  font-weight: 700;
  cursor: pointer;
}

/* Dark Mode adjustment */
.dark .premium-login-page {
  background: linear-gradient(135deg, #000000, #1a1a1a, #2c2c2c);
}/* =========================================
   LOYALTY POINTS & WALLET CSS
========================================= */
.rewards-section {
  margin-bottom: 25px;
}

.rewards-header {
  margin-bottom: 15px;
}

.rewards-header h3 {
  font-size: 20px;
  color: var(--text-dark);
}

.rewards-grid {
  display: flex;
  gap: 15px;
}

.reward-card {
  flex: 1;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 15px;
  display: flex;
  align-items: center;
  gap: 12px;
  position: relative;
}

.loyalty-card {
  background: linear-gradient(135deg, #ffd166, #ffb703);
}

.wallet-card {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
}

.reward-icon {
  font-size: 30px;
}

.reward-info {
  flex: 1;
}

.reward-info strong {
  display: block;
  font-size: 18px;
  margin-bottom: 3px;
}

.reward-info small {
  font-size: 12px;
  opacity: 0.8;
}

.reward-action span {
  font-size: 12px;
  font-weight: 600;
  opacity: 0.8;
}

.wallet-add-button {
  background: var(--white);
  color: var(--primary);
  border: none;
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.account-coupon-section {
  margin-bottom: 25px;
}

.account-coupon-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.account-coupon-card {
  background: var(--bg);
  border: 1px dashed var(--primary);
  border-radius: 8px;
  padding: 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.account-coupon-card strong {
  color: var(--primary);
  font-size: 16px;
}

.account-coupon-card span {
  background: var(--primary);
  color: var(--white);
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
}

.account-coupon-card small {
  font-size: 12px;
  color: var(--text);
  margin-left: auto;
}

.no-coupons {
  color: var(--text);
  font-size: 14px;
}

/* Dark Mode Fix */
.dark .loyalty-card {
  background: #3a2e00;
}

.dark .wallet-card {
  background: #0a3d38;
}

.dark .account-coupon-card {
  background: var(--bg);
  border: 1px dashed var(--primary);
}/* =========================================
   PAYMENT REWARDS CSS
========================================= */
.payment-rewards-section {
  margin-bottom: 20px;
}

.payment-rewards-section h3 {
  font-size: 18px;
  color: var(--text-dark);
  margin-bottom: 15px;
}

.reward-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.reward-option {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border);
  padding: 15px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s;
}

.reward-option:hover {
  border-color: var(--primary);
}

.reward-option.active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.reward-option input {
  accent-color: var(--primary);
}

.reward-option strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.reward-option small {
  font-size: 12px;
  color: var(--text);
}

.discount-item {
  color: #16a34a;
}

.discount-item strong {
  color: #16a34a;
}

/* Dark Mode Fix */
.dark .reward-option {
  border: 1px solid var(--border);
  background: var(--bg);
}

.dark .reward-option.active,
.dark .reward-option:hover {
  border-color: var(--primary);
  background: var(--primary-light);
}

.dark .reward-option strong {
  color: var(--text-dark);
}/* =========================================
   ADMIN & RIDER PANEL CSS
========================================= */
.admin-panel, .rider-panel {
  background: var(--bg);
  min-height: 100vh;
  padding: 20px;
}

.admin-header, .rider-header {
  max-width: 1000px;
  margin: 0 auto;
  background: var(--white);
  border-radius: 12px;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow);
  margin-bottom: 20px;
}

.admin-header-left, .rider-header-left {
  display: flex;
  align-items: center;
  gap: 15px;
}

.admin-logo, .rider-logo {
  font-size: 40px;
}

.admin-header-left h1, .rider-header-left h1 {
  font-size: 24px;
  color: var(--text-dark);
}

.admin-header-left p, .rider-header-left p {
  font-size: 13px;
  color: var(--text);
}

.admin-header-right, .rider-header-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.admin-home-btn, .rider-home-btn, .admin-logout-btn, .rider-logout-btn {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  color: var(--text-dark);
}

.admin-logout-btn, .rider-logout-btn {
  background: #fee2e2;
  color: #dc2626;
  border-color: #fee2e2;
}

.admin-stats, .rider-stats {
  max-width: 1000px;
  margin: 0 auto;
  display: flex;
  gap: 15px;
  margin-bottom: 20px;
}

.admin-stat, .rider-stat {
  flex: 1;
  background: var(--white);
  border-radius: 12px;
  padding: 15px;
  text-align: center;
  box-shadow: var(--shadow);
}

.admin-stat strong, .rider-stat strong {
  display: block;
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.admin-stat span, .rider-stat span {
  font-size: 13px;
  color: var(--text);
}

.admin-orders, .rider-orders {
  max-width: 1000px;
  margin: 0 auto;
}

.admin-orders h2, .rider-orders h2 {
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 20px;
}

.admin-order-list, .rider-order-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.admin-order-card, .rider-order-card {
  background: var(--white);
  border-radius: 12px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.admin-order-header, .rider-order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.admin-order-header strong, .rider-order-header strong {
  font-size: 16px;
  color: var(--text-dark);
}

.admin-order-header span, .rider-order-header span {
  font-size: 12px;
  color: var(--text);
}

.admin-order-items div {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

.admin-order-total {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
  margin-bottom: 15px;
}

.admin-order-total strong {
  color: var(--primary);
}

.admin-order-actions, .rider-order-actions {
  display: flex;
  gap: 8px;
  margin-top: 15px;
}

.status-btn {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.status-btn.active {
  background: var(--primary);
  color: var(--white);
}

.accept-btn {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.complete-btn {
  background: #16a34a;
  color: var(--white);
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.delivered-label {
  background: #f0fdf4;
  color: #16a34a;
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
}

.no-orders {
  text-align: center;
  color: var(--text);
  font-size: 16px;
  padding: 20px;
}

/* Dark Mode Fix */
.dark .admin-panel, .dark .rider-panel {
  background: var(--bg);
}

.dark .admin-header, .dark .rider-header,
.dark .admin-order-card, .dark .rider-order-card,
.dark .admin-stat, .dark .rider-stat {
  background: var(--white);
}

.dark .admin-header-left h1, .dark .rider-header-left h1,
.dark .admin-order-header strong, .dark .rider-order-header strong {
  color: var(--text-dark);
}/* =========================================
   WALLET TRANSACTIONS & POINTS HISTORY CSS
========================================= */
.wallet-transactions-section,
.points-history-section {
  margin-bottom: 25px;
}

.wallet-transaction-list,
.points-history-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.wallet-transaction-card,
.points-history-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.transaction-icon,
.points-icon {
  font-size: 20px;
}

.transaction-info,
.points-info {
  flex: 1;
}

.transaction-info strong,
.points-info strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
}

.transaction-info small,
.points-info small {
  font-size: 12px;
  color: var(--text);
}

.transaction-amount.credit {
  color: #16a34a;
}

.transaction-amount.debit {
  color: #dc2626;
}

.points-amount {
  color: #16a34a;
  font-weight: 700;
}

.no-transactions {
  color: var(--text);
  font-size: 14px;
}

/* Dark Mode Fix */
.dark .wallet-transaction-card,
.dark .points-history-card {
  background: var(--bg);
  border: 1px solid var(--border);
}

.dark .transaction-info strong,
.dark .points-info strong {
  color: var(--text-dark);
}/* =========================================
   LIVE CHAT CSS
========================================= */
.live-chat-button {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: var(--primary);
  color: var(--white);
  border: none;
  border-radius: 50%;
  width: 60px;
  height: 60px;
  font-size: 24px;
  cursor: pointer;
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  transition: all 0.3s;
}

.live-chat-button:hover,
.live-chat-button.active {
  background: var(--primary-dark);
  transform: scale(1.1);
}

.live-chat-box {
  position: fixed;
  bottom: 90px;
  right: 20px;
  width: 350px;
  max-width: 90vw;
  background: var(--white);
  border-radius: 16px;
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  overflow: hidden;
}

.live-chat-header {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  padding: 15px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.live-chat-avatar {
  font-size: 30px;
}

.live-chat-header strong {
  display: block;
  font-size: 16px;
}

.live-chat-header small {
  font-size: 12px;
  opacity: 0.8;
}

.live-chat-messages {
  padding: 15px;
  max-height: 300px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.chat-message {
  padding: 8px 12px;
  border-radius: 12px;
  max-width: 80%;
  font-size: 14px;
  line-height: 1.4;
}

.chat-message.admin {
  background: var(--bg);
  color: var(--text-dark);
  align-self: flex-start;
}

.chat-message.user {
  background: var(--primary);
  color: var(--white);
  align-self: flex-end;
}

.live-chat-input {
  padding: 10px;
  border-top: 1px solid var(--border);
  display: flex;
  gap: 8px;
}

.live-chat-input input {
  flex: 1;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 14px;
  outline: none;
}

.live-chat-input button {
  background: var(--primary);
  color: var(--white);
  border: none;
  border-radius: 8px;
  padding: 10px 15px;
  font-size: 16px;
  cursor: pointer;
}

/* Dark Mode Fix */
.dark .live-chat-box {
  background: var(--white);
}

.dark .chat-message.admin {
  background: var(--bg);
  color: var(--text-dark);
}/* =========================================
   TIME SLOT CSS
========================================= */
.time-slot-section {
  margin-bottom: 20px;
}

.time-slot-section label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.time-slot-options {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.time-slot-btn {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.time-slot-btn.active {
  background: var(--primary);
  color: var(--white);
  border-color: var(--primary);
}

/* Dark Mode Fix */
.dark .time-slot-section label {
  color: var(--text-dark);
}

.dark .time-slot-btn {
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text);
}/* =========================================
   LIVE CHAT & FLOATING CART BUTTON SEPARATION
========================================= */
.floating-cart-button {
  position: fixed;
  bottom: 90px; /* 20px থেকে 90px এ সরানো হয়েছে */
  right: 20px;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 15px 20px;
  border-radius: 50px;
  font-size: 16px;
  font-weight: 700;
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  transition: all 0.3s;
}

.floating-cart-button:hover {
  transform: scale(1.05);
}

.live-chat-button {
  position: fixed;
  bottom: 20px; /* নিচে থাকবে */
  right: 20px;
  background: var(--primary);
  color: var(--white);
  border: none;
  border-radius: 50%;
  width: 60px;
  height: 60px;
  font-size: 24px;
  cursor: pointer;
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  transition: all 0.3s;
}

.live-chat-button:hover,
.live-chat-button.active {
  background: var(--primary-dark);
  transform: scale(1.1);
}

.live-chat-box {
  position: fixed;
  bottom: 90px; /* Cart Button এর উপরে */
  right: 20px;
  width: 350px;
  max-width: 90vw;
  background: var(--white);
  border-radius: 16px;
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  overflow: hidden;
}/* =========================================
   VOICE SEARCH & MENU SEARCH CSS
========================================= */
.voice-search-button {
  background: transparent;
  border: none;
  font-size: 20px;
  cursor: pointer;
  padding: 0 8px;
}

.listening-indicator {
  font-size: 18px;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.3); }
}

.menu-search-bar {
  display: flex;
  align-items: center;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 12px;
  margin-bottom: 20px;
  box-shadow: var(--shadow);
}

.menu-search-bar span {
  font-size: 18px;
  margin-right: 8px;
}

.menu-search-bar input {
  flex: 1;
  border: none;
  outline: none;
  padding: 8px;
  font-size: 14px;
  background: transparent;
}

.menu-search-bar .clear-search {
  background: transparent;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: var(--text);
}

.no-menu-items {
  text-align: center;
  color: var(--text);
  padding: 20px;
  width: 100%;
}

/* Dark Mode Fix */
.dark .menu-search-bar {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .menu-search-bar input {
  color: var(--text-dark);
}/* =========================================
   ADMIN & RIDER DASHBOARD CSS
========================================= */
.admin-stats,
.rider-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 15px;
  margin-bottom: 20px;
}

.admin-stat,
.rider-stat {
  flex: 1;
  background: var(--white);
  border-radius: 12px;
  padding: 15px;
  text-align: center;
  box-shadow: var(--shadow);
}

.admin-stat strong,
.rider-stat strong {
  display: block;
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.admin-stat span,
.rider-stat span {
  font-size: 13px;
  color: var(--text);
}

.admin-orders,
.rider-orders {
  max-width: 1000px;
  margin: 0 auto;
}

.admin-orders h2,
.rider-orders h2 {
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 20px;
}

.admin-order-list,
.rider-order-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.admin-order-card,
.rider-order-card {
  background: var(--white);
  border-radius: 12px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.admin-order-header,
.rider-order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.admin-order-header strong,
.rider-order-header strong {
  font-size: 16px;
  color: var(--text-dark);
}

.admin-order-header span,
.rider-order-header span {
  font-size: 12px;
  color: var(--text);
}

.admin-order-items div {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

.admin-order-total {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
  margin-bottom: 15px;
}

.admin-order-total strong {
  color: var(--primary);
}

.admin-order-actions,
.rider-order-actions {
  display: flex;
  gap: 8px;
  margin-top: 15px;
}

.status-btn {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.status-btn.active {
  background: var(--primary);
  color: var(--white);
}

.accept-btn {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.complete-btn {
  background: #16a34a;
  color: var(--white);
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.delivered-label {
  background: #f0fdf4;
  color: #16a34a;
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
}

.no-orders {
  text-align: center;
  color: var(--text);
  font-size: 16px;
  padding: 20px;
}

/* Dark Mode Fix */
.dark .admin-panel,
.dark .rider-panel {
  background: var(--bg);
}

.dark .admin-header,
.dark .rider-header,
.dark .admin-order-card,
.dark .rider-order-card,
.dark .admin-stat,
.dark .rider-stat {
  background: var(--white);
}

.dark .admin-header-left h1,
.dark .rider-header-left h1,
.dark .admin-order-header strong,
.dark .rider-order-header strong {
  color: var(--text-dark);
}/* =========================================
   ADMIN DASHBOARD CSS
========================================= */
.admin-view-toggle {
  max-width: 1000px;
  margin: 0 auto;
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.view-btn {
  flex: 1;
  background: var(--white);
  border: 1px solid var(--border);
  padding: 12px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  color: var(--text-dark);
}

.view-btn.active {
  background: var(--primary);
  color: var(--white);
  border-color: var(--primary);
}

.admin-charts {
  max-width: 1000px;
  margin: 0 auto;
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}

.chart-card {
  flex: 1;
  min-width: 300px;
  background: var(--white);
  border-radius: 12px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.chart-card h3 {
  font-size: 18px;
  color: var(--text-dark);
  margin-bottom: 15px;
}

/* Dark Mode Fix */
.dark .admin-view-toggle,
.dark .chart-card {
  background: var(--white);
}

.dark .view-btn {
  background: var(--bg);
  color: var(--text-dark);
  border: 1px solid var(--border);
}

.dark .view-btn.active {
  background: var(--primary);
  color: var(--white);
}

.dark .chart-card h3 {
  color: var(--text-dark);
}/* =========================================
   NOTIFICATION PANEL CSS
========================================= */
.old-notification-button {
  position: fixed;
  bottom: 90px;
  left: 20px;
  background: #ffb703;
  color: var(--white);
  border: none;
  border-radius: 50%;
  width: 60px;
  height: 60px;
  font-size: 24px;
  cursor: pointer;
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  transition: all 0.3s;
}

.old-notification-button:hover,
.old-notification-button.active {
  background: #ff9f1c;
  transform: scale(1.1);
}

.old-notification-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #dc2626;
  color: var(--white);
  font-size: 12px;
  font-weight: 700;
  border-radius: 50%;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.old-notification-box {
  position: fixed;
  bottom: 160px;
  left: 20px;
  width: 350px;
  max-width: 90vw;
  background: var(--white);
  border-radius: 16px;
  box-shadow: var(--shadow-lg);
  z-index: 1000;
  overflow: hidden;
}

.old-notification-header {
  background: linear-gradient(135deg, #ffb703, #ff9f1c);
  color: var(--white);
  padding: 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.old-notification-header strong {
  font-size: 16px;
}

.old-notification-header span {
  font-size: 12px;
  opacity: 0.8;
}

/* Dark Mode Fix */
.dark .old-notification-box {
  background: var(--white);
}

/* Navbar আরো ছোট ও কমপ্যাক্ট করা */
.arai-navbar-inner {
  padding: 8px 12px;
  gap: 5px;
}

.arai-nav-actions {
  gap: 5px;
}

.arai-logo {
  gap: 6px;
}

.arai-logo-icon {
  width: 30px;
  height: 30px;
  font-size: 15px;
}

.arai-logo-text span {
  font-size: 14px;
}

.arai-logo-text small {
  font-size: 9px;
}

.arai-nav-icon {
  font-size: 15px;
}

.arai-nav-links a {
  font-size: 12px;
  gap: 8px;
}

.arai-cart-button {
  width: 30px;
  height: 30px;
  font-size: 14px;
}

.arai-cart-badge {
  width: 14px;
  height: 14px;
  font-size: 8px;
}

.arai-account-button {
  padding: 5px 8px;
  font-size: 11px;
}

/* Navbar-এ Account button ও Menu button-এর জায়গা ঠিক করা */
.arai-account-text {
  display: none;
}

/* ডানদিকে যাওয়ার (Scroll) সমস্যা সমাধান */
.arai-navbar-inner {
  max-width: 100%;
  overflow-x: hidden;
}

/* Home Page-এর Layout ঠিক করা */
.arai-hero-container {
  gap: 15px;
}

.arai-hero-content h1 {
  font-size: 32px;
}

.arai-hero-search {
  max-width: 100%;
}

.arai-hero-features {
  gap: 10px;
}

.arai-hero-feature strong {
  font-size: 12px;
}

.arai-hero-feature small {
  font-size: 10px;
}

/* Categories আরো ছোট করা (Home Page adjust) */
.categories-header h2 {
  font-size: 24px;
}

.category-grid {
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 10px;
}

.category-card {
  padding: 12px;
}

.category-icon {
  font-size: 28px;
}

.category-card h3 {
  font-size: 13px;
}

/* Popular Restaurants আরো ছোট করা */
.restaurants-header h2 {
  font-size: 24px;
}

.restaurant-grid {
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 12px;
}

.restaurant-image {
  height: 100px;
  font-size: 40px;
}

.restaurant-info h3 {
  font-size: 14px;
}

.restaurant-info p {
  font-size: 11px;
}

/* Offers Section ছোট করা */
.offers-content {
  padding: 20px;
}

.offers-text h2 {
  font-size: 22px;
}

.offers-text p {
  font-size: 12px;
}

/* Notification Button ঠিক করা */

/* =========================================
   DARK MODE FIX (SHORT)
========================================= */
.dark .arai-logo-text span,
.dark h1,
.dark h2,
.dark h3 {
  color: var(--text-dark);
}

.dark .arai-navbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
}

.dark .arai-nav-links a {
  color: var(--text);
}

.dark .arai-nav-links a:hover,
.dark .arai-nav-links a.active {
  color: var(--primary);
}/* =========================================
   FINAL COMPACT NAVBAR (সব Button সহ)
========================================= */

/* Navbar Base */
.arai-navbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.arai-navbar-inner {
  max-width: 1300px;
  margin: 0 auto;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  overflow: hidden;
}

/* Logo - Medium Size */
.arai-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.arai-logo-icon {
  width: 38px;
  height: 38px;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: 0 4px 10px rgba(19, 168, 158, 0.3);
  position: relative;
  overflow: hidden;
}

.arai-logo-icon .logo-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  animation: logoPulse 2s infinite;
}

@keyframes logoPulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 0; }
}

.arai-logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.arai-logo-text .logo-title {
  font-weight: 900;
  font-size: 15px;
  letter-spacing: 0.5px;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.arai-logo-text .logo-subtitle {
  font-size: 9px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.5px;
}

/* Links - One Line */
.arai-nav-links {
  display: flex;
  gap: 25px;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.arai-nav-links a {
  font-weight: 600;
  color: var(--text);
  font-size: 15px;
  white-space: nowrap;
  transition: all 0.2s;
}

.arai-nav-links a:hover,
.arai-nav-links a.active {
  color: var(--primary);
}

/* Actions - শুধু Icon */
.arai-nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.arai-nav-icon {
  background: transparent;
  border: none;
  font-size: 20px;
  color: var(--text-dark);
  position: relative;
}

.arai-cart-button {
  background: var(--primary-light);
  border: none;
  border-radius: 50%;
  width: 38px;
  height: 38px;
  font-size: 20px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arai-cart-badge {
  position: absolute;
  top: -2px;
  right: -2px;
  background: var(--primary);
  color: var(--white);
  font-size: 9px;
  font-weight: 700;
  border-radius: 50%;
  width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arai-account-button {
  background: var(--text-dark);
  color: var(--white);
  border: none;
  padding: 8px 10px;
  border-radius: 30px;
  display: flex;
  align-items: center;
  gap: 5px;
  font-weight: 700;
  font-size: 12px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.arai-account-icon {
  font-size: 15px;
}

.arai-account-text {
  display: block;
}

/* Mobile */
@media (max-width: 768px) {
  .arai-nav-links {
    display: none;
  }
  .arai-account-text {
    display: none;
  }
  .arai-account-button {
    padding: 8px 10px;
  }
  .arai-menu-button {
    display: block;
  }
  .arai-navbar-inner {
    padding: 10px 15px;
    gap: 8px;
  }
  .arai-logo-icon {
    width: 32px;
    height: 32px;
    font-size: 17px;
  }
  .arai-logo-text .logo-title {
    font-size: 13px;
  }
  .arai-logo-text .logo-subtitle {
    font-size: 8px;
  }
  .arai-nav-actions {
    gap: 5px;
  }
  .arai-nav-icon {
    font-size: 16px;
  }
  .arai-cart-button {
    width: 32px;
    height: 32px;
    font-size: 16px;
  }
}

/* Notification Button */


/* Dark Mode Fix */
.dark .arai-navbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
}

.dark .arai-nav-links a {
  color: var(--text);
}

.dark .arai-nav-links a:hover,
.dark .arai-nav-links a.active {
  color: var(--primary);
}

.dark .arai-account-button {
  background: var(--text-dark);
}/* =========================================
   COUPON CODE & FREE DELIVERY CSS
========================================= */
.coupon-section-checkout {
  margin-bottom: 15px;
}

.coupon-section-checkout h3 {
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.coupon-input-group {
  display: flex;
  gap: 8px;
}

.coupon-input-group input {
  flex: 1;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 13px;
  outline: none;
}

.coupon-input-group button {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 10px 15px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.coupon-error {
  color: #dc2626;
  font-size: 12px;
  margin-top: 8px;
}

.coupon-success {
  color: #16a34a;
  font-size: 12px;
  margin-top: 8px;
  font-weight: 600;
}

.discount-item {
  color: #16a34a;
}

.discount-item strong {
  color: #16a34a;
}

/* Dark Mode Fix */
.dark .coupon-section-checkout h3 {
  color: var(--text-dark);
}

.dark .coupon-input-group input {
  background: var(--bg);
  color: var(--text-dark);
  border: 1px solid var(--border);
}

.dark .coupon-error {
  color: #fca5a5;
}

.dark .coupon-success {
  color: #86efac;
}/* =========================================
   TRACK ORDER & ORDER HISTORY BUTTON CSS
========================================= */
.track-order-button {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  display: inline-block;
}

.order-history-actions {
  display: flex;
  gap: 8px;
  margin-top: 15px;
}

.reorder-button {
  background: #f59e0b;
  color: var(--white);
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.remove-order-button {
  background: #fee2e2;
  color: #dc2626;
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

/* Dark Mode Fix */
.dark .track-order-button {
  background: var(--primary);
  color: var(--white);
}

.dark .reorder-button {
  background: #f59e0b;
  color: var(--white);
}

.dark .remove-order-button {
  background: #450a0a;
  color: #fecaca;
}/* =========================================
   RESTAURANT PANEL CSS
========================================= */
.restaurant-panel {
  background: var(--bg);
  min-height: 100vh;
  padding: 20px;
}

.restaurant-panel-header {
  max-width: 1000px;
  margin: 0 auto;
  background: var(--white);
  border-radius: 12px;
  padding: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow);
  margin-bottom: 20px;
}

.restaurant-panel-left {
  display: flex;
  align-items: center;
  gap: 15px;
}

.restaurant-panel-logo {
  font-size: 40px;
}

.restaurant-panel-left h1 {
  font-size: 24px;
  color: var(--text-dark);
}

.restaurant-panel-left p {
  font-size: 13px;
  color: var(--text);
}

.restaurant-panel-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.restaurant-home-btn,
.restaurant-logout-btn {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  color: var(--text-dark);
}

.restaurant-logout-btn {
  background: #fee2e2;
  color: #dc2626;
  border-color: #fee2e2;
}

.restaurant-menu-section,
.restaurant-orders-section {
  max-width: 1000px;
  margin: 0 auto;
  margin-bottom: 20px;
}

.restaurant-menu-section h2,
.restaurant-orders-section h2 {
  font-size: 22px;
  color: var(--text-dark);
  margin-bottom: 15px;
}

.add-menu-item-btn {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 10px 16px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
  margin-bottom: 15px;
}

.restaurant-menu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 15px;
}

.restaurant-menu-card {
  background: var(--white);
  border-radius: 12px;
  padding: 15px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: var(--shadow);
}

.restaurant-menu-emoji {
  font-size: 30px;
}

.restaurant-menu-info {
  flex: 1;
}

.restaurant-menu-info strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.restaurant-menu-info span {
  font-size: 13px;
  color: var(--primary);
  font-weight: 600;
}

.remove-menu-item {
  background: #fee2e2;
  color: #dc2626;
  border: none;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  font-size: 14px;
  cursor: pointer;
}

.restaurant-order-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.restaurant-order-card {
  background: var(--white);
  border-radius: 12px;
  padding: 20px;
  box-shadow: var(--shadow);
}

.restaurant-order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.restaurant-order-header strong {
  font-size: 16px;
  color: var(--text-dark);
}

.restaurant-order-header span {
  font-size: 12px;
  color: var(--text);
}

.restaurant-order-items div {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
}

.restaurant-order-total {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
  margin-bottom: 15px;
}

.restaurant-order-total strong {
  color: var(--primary);
}

.restaurant-order-actions {
  display: flex;
  gap: 8px;
  margin-top: 15px;
}

.status-btn {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.status-btn.active {
  background: var(--primary);
  color: var(--white);
}

.no-orders {
  text-align: center;
  color: var(--text);
  font-size: 16px;
  padding: 20px;
}

/* Dark Mode Fix */
.dark .restaurant-panel-header,
.dark .restaurant-menu-card,
.dark .restaurant-order-card {
  background: var(--white);
}

.dark .restaurant-panel-left h1,
.dark .restaurant-order-header strong {
  color: var(--text-dark);
}/* =========================================
   RIDER PROFILE & EARNINGS CHART CSS
========================================= */
.rider-profile-card {
  max-width: 1000px;
  margin: 0 auto;
  background: var(--white);
  border-radius: 12px;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 15px;
  box-shadow: var(--shadow);
  margin-bottom: 20px;
}

.rider-profile-avatar {
  font-size: 50px;
}

.rider-profile-info {
  flex: 1;
}

.rider-profile-info strong {
  display: block;
  font-size: 20px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.rider-profile-info small {
  display: block;
  font-size: 13px;
  color: var(--text);
  margin-bottom: 5px;
}

.rider-profile-info span {
  font-size: 13px;
  color: #f59e0b;
  font-weight: 700;
}

.rider-chart-section {
  max-width: 1000px;
  margin: 0 auto;
  background: var(--white);
  border-radius: 12px;
  padding: 20px;
  box-shadow: var(--shadow);
  margin-bottom: 20px;
}

.rider-chart-section h2 {
  font-size: 20px;
  color: var(--text-dark);
  margin-bottom: 15px;
}

/* Delivery Status Bars for Admin */
.delivery-status-bars {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.status-bar-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.status-bar-row span {
  width: 80px;
  font-size: 13px;
  color: var(--text);
}

.status-bar-container {
  flex: 1;
  height: 10px;
  background: var(--bg);
  border-radius: 5px;
  overflow: hidden;
}

.status-bar {
  height: 100%;
  border-radius: 5px;
}

.status-bar.delivered {
  background: #16a34a;
}

.status-bar.preparing {
  background: #f59e0b;
}

.status-bar.delivering {
  background: var(--primary);
}

.status-bar-row strong {
  width: 30px;
  font-size: 14px;
  color: var(--text-dark);
}

/* Dark Mode Fix */
.dark .rider-profile-card,
.dark .rider-chart-section {
  background: var(--white);
}

.dark .rider-profile-info strong,
.dark .rider-chart-section h2 {
  color: var(--text-dark);
}

.dark .status-bar-row span {
  color: var(--text);
}

.dark .status-bar-container {
  background: var(--bg);
}

.dark .status-bar-row strong {
  color: var(--text-dark);
}/* =========================================
   WALLET PAYMENT & NOTIFICATION CSS
========================================= */
.no-notifications {
  text-align: center;
  color: var(--text);
  padding: 20px;
  font-size: 13px;
}

/* Dark Mode Fix */
.dark .no-notifications {
  color: var(--text);
}/* =========================================
   MAP PICKER CSS
========================================= */
.map-selection-section {
  margin-bottom: 15px;
}

.map-selection-section h3 {
  font-size: 14px;
  color: var(--text-dark);
  margin-bottom: 8px;
}

.selected-location {
  font-size: 12px;
  color: var(--primary);
  font-weight: 600;
  margin-top: 8px;
}

/* Dark Mode Fix */
.dark .map-selection-section h3 {
  color: var(--text-dark);
}/* =========================================
   MAP PICKER CSS (FIXED)
========================================= */
.map-selection-section {
  margin-bottom: 20px;
}

.map-selection-section h3 {
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 8px;
}

.map-selection-section .MapContainer {
  border-radius: 12px;
  border: 1px solid var(--border);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.selected-location-box {
  background: var(--primary-light);
  color: var(--text-dark);
  padding: 8px;
  border-radius: 8px;
  margin-top: 8px;
  font-size: 12px;
  font-weight: 600;
  display: flex;
  gap: 6px;
  align-items: center;
}

.selected-location-box span {
  color: var(--primary);
}

/* Dark Mode Fix */
.dark .map-selection-section h3 {
  color: var(--text-dark);
}

.dark .selected-location-box {
  background: var(--bg);
  color: var(--text-dark);
}/* =========================================
   MAP SEARCH BAR CSS
========================================= */
.map-search-bar {
  display: flex;
  align-items: center;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 10px;
  margin-bottom: 10px;
}

.map-search-bar span {
  font-size: 16px;
  margin-right: 6px;
}

.map-search-bar input {
  flex: 1;
  border: none;
  outline: none;
  padding: 4px;
  font-size: 13px;
  background: transparent;
}

.map-search-bar button {
  background: transparent;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: var(--text);
}

.map-search-bar button:hover {
  color: var(--primary);
}

/* Dark Mode Fix */
.dark .map-search-bar {
  background: var(--bg);
  color: var(--text-dark);
  border: 1px solid var(--border);
}

.dark .map-search-bar input {
  color: var(--text-dark);
}/* =========================================
   GOOGLE MAP PICKER CSS
========================================= */
.map-selection-section {
  margin-bottom: 20px;
}

.map-selection-section h3 {
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 8px;
}

.selected-location-box {
  background: var(--primary-light);
  color: var(--text-dark);
  padding: 8px;
  border-radius: 8px;
  margin-top: 8px;
  font-size: 12px;
  font-weight: 600;
  display: flex;
  gap: 6px;
  align-items: center;
}

.dark .map-selection-section h3 {
  color: var(--text-dark);
}

.dark .selected-location-box {
  background: var(--bg);
}/* =========================================
   GOOGLE MAP PREMIUM LOOK & RESPONSIVE FIX
========================================= */
.map-selection-section {
  margin-bottom: 20px;
}

.map-selection-section h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 12px;
}

.map-selection-section .GoogleMap {
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  overflow: hidden;
  position: relative;
}

.selected-location-box {
  background: var(--primary-light);
  color: var(--text-dark);
  padding: 12px;
  border-radius: 12px;
  margin-top: 12px;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  gap: 8px;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.selected-location-box span {
  color: var(--primary);
}

/* Loading Map State */
.loading-map {
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  overflow: hidden;
  height: 350px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: var(--text);
  background: var(--bg);
}

/* Tablet (768px - 1024px) */
@media (max-width: 1024px) {
  .map-selection-section .GoogleMap,
  .loading-map {
    height: 300px;
  }
}

/* Mobile (768px এর নিচে) */
@media (max-width: 768px) {
  .map-selection-section .GoogleMap,
  .loading-map {
    height: 250px;
    border-radius: 12px;
  }
  
  .selected-location-box {
    font-size: 11px;
    padding: 8px;
  }
}

/* Dark Mode Fix */
.dark .selected-location-box {
  background: var(--bg);
  color: var(--text-dark);
}/* =========================================
   RIDER LOCATION MAP CSS
========================================= */
.rider-location-map {
  margin-top: 20px;
}

.rider-location-map h3 {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.rider-location-text {
  font-size: 13px;
  font-weight: 600;
  color: var(--primary);
  margin-top: 10px;
  text-align: center;
}

/* Dark Mode Fix */
.dark .rider-location-map h3 {
  color: var(--text-dark);
}/* =========================================
   OUTSIDE SERVICE AREA MODAL CSS
========================================= */
.outside-area-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.outside-area-modal-content {
  background: var(--white);
  border-radius: 20px;
  padding: 30px;
  max-width: 500px;
  width: 100%;
  text-align: center;
  box-shadow: var(--shadow-lg);
}

.outside-area-icon {
  font-size: 60px;
  margin-bottom: 15px;
}

.outside-area-modal-content h2 {
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 15px;
}

.outside-area-modal-content p {
  font-size: 15px;
  line-height: 1.6;
  color: var(--text);
  margin-bottom: 20px;
}

.outside-area-close-btn {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 12px 20px;
  border-radius: 12px;
  font-weight: 700;
  cursor: pointer;
}

/* Dark Mode Fix */
.dark .outside-area-modal-content {
  background: var(--white);
}

.dark .outside-area-modal-content h2 {
  color: var(--text-dark);
}/* =========================================
   NAVBAR CSS (Fixed)
========================================= */
.arai-navbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.arai-navbar-inner {
  max-width: 1300px;
  margin: 0 auto;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  overflow: hidden;
}

.arai-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.arai-logo-icon {
  width: 38px;
  height: 38px;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: 0 4px 10px rgba(19, 168, 158, 0.3);
  position: relative;
  overflow: hidden;
}

.arai-logo-icon .logo-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 12px;
  animation: logoPulse 2s infinite;
}

@keyframes logoPulse {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 0; }
}

.arai-logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.arai-logo-text .logo-title {
  font-weight: 900;
  font-size: 15px;
  letter-spacing: 0.5px;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.arai-logo-text .logo-subtitle {
  font-size: 9px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.5px;
}

.arai-nav-links {
  display: flex;
  gap: 25px;
  align-items: center;
  justify-content: center;
  flex: 1;
}

.arai-nav-links a {
  font-weight: 600;
  color: var(--text);
  font-size: 15px;
  white-space: nowrap;
  transition: all 0.2s;
}

.arai-nav-links a:hover,
.arai-nav-links a.active {
  color: var(--primary);
}

.arai-nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.arai-nav-icon {
  background: transparent;
  border: none;
  font-size: 20px;
  color: var(--text-dark);
  position: relative;
}

.arai-cart-button {
  background: var(--primary-light);
  border: none;
  border-radius: 50%;
  width: 38px;
  height: 38px;
  font-size: 20px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arai-cart-badge {
  position: absolute;
  top: -2px;
  right: -2px;
  background: var(--primary);
  color: var(--white);
  font-size: 9px;
  font-weight: 700;
  border-radius: 50%;
  width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arai-account-button {
  background: var(--text-dark);
  color: var(--white);
  border: none;
  padding: 8px 10px;
  border-radius: 30px;
  display: flex;
  align-items: center;
  gap: 5px;
  font-weight: 700;
  font-size: 12px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.arai-account-icon {
  font-size: 15px;
}

@media (max-width: 768px) {
  .arai-nav-links {
    display: none;
  }
  .arai-account-text {
    display: none;
  }
  .arai-account-button {
    padding: 8px 10px;
  }
  .arai-menu-button {
    display: block;
  }
  .arai-navbar-inner {
    padding: 10px 15px;
    gap: 8px;
  }
  .arai-logo-icon {
    width: 32px;
    height: 32px;
    font-size: 17px;
  }
  .arai-logo-text .logo-title {
    font-size: 13px;
  }
  .arai-logo-text .logo-subtitle {
    font-size: 8px;
  }
  .arai-nav-actions {
    gap: 5px;
  }
  .arai-nav-icon {
    font-size: 16px;
  }
  .arai-cart-button {
    width: 32px;
    height: 32px;
    font-size: 16px;
  }
}/* =========================================
   NAVBAR FINAL FIX (Forcing Display)
========================================= */
@media (min-width: 768px) {
  .arai-nav-links {
    display: flex !important;
    visibility: visible !important;
    opacity: 1 !important;
    gap: 25px !important;
  }

  .arai-nav-links a {
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
    color: var(--text) !important;
    font-size: 15px !important;
  }
}

/* Nabar-এর সব লিংক সাদা ব্যাকগ্রাউন্ডে দৃশ্যমান */
.arai-navbar {
  background: var(--white) !important;
}

.arai-navbar-inner {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
}/* =========================================
   NAVBAR FINAL COMPACT FIX
========================================= */
.arai-navbar-inner {
  max-width: 1400px !important;
  padding: 8px 15px !important;
  gap: 8px !important;
}

.arai-logo-icon {
  width: 32px !important;
  height: 32px !important;
  font-size: 17px !important;
}

.arai-logo-text .logo-title {
  font-size: 13px !important;
}

.arai-logo-text .logo-subtitle {
  font-size: 8px !important;
}

.arai-nav-links {
  gap: 12px !important;
}

.arai-nav-links a {
  font-size: 12px !important;
}

.arai-nav-actions {
  gap: 4px !important;
}

.arai-nav-icon {
  font-size: 15px !important;
}

.arai-cart-button {
  width: 30px !important;
  height: 30px !important;
  font-size: 15px !important;
}

.arai-cart-badge {
  width: 13px !important;
  height: 13px !important;
  font-size: 8px !important;
}

.arai-account-button {
  padding: 6px 8px !important;
  font-size: 10px !important;
}

.arai-account-icon {
  font-size: 12px !important;
}

/* Notification Button */

/* Mobile-এ আগের মতোই থাকবে */
@media (max-width: 900px) {
  .arai-nav-links {
    display: none;
  }
  .arai-account-text {
    display: none;
  }
}/* =========================================
   NAVBAR ACTIVE LINK DESIGN
========================================= */
.arai-nav-links .nav-link {
  position: relative;
  font-weight: 600;
  color: var(--text);
  font-size: 15px;
  padding: 6px 0;
  transition: all 0.3s ease;
}

.arai-nav-links .nav-link:hover {
  color: var(--primary);
}

.arai-nav-links .nav-link.active {
  color: var(--primary);
  font-weight: 700;
}

/* Active Link-এর নিচে সুন্দর আন্ডারলাইন */
.arai-nav-links .nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, #13a89e, #0e7f78);
  border-radius: 3px;
  animation: slideIn 0.3s ease;
}

/* Active Link-এর উপর হালকা গ্লো */
.arai-nav-links .nav-link.active {
  text-shadow: 0 0 8px rgba(19, 168, 158, 0.4);
}

@keyframes slideIn {
  from {
    width: 0%;
    opacity: 0;
  }
  to {
    width: 100%;
    opacity: 1;
  }
}

/* Dark Mode Fix */
.dark .arai-nav-links .nav-link {
  color: var(--text);
}

.dark .arai-nav-links .nav-link.active {
  color: var(--primary);
}/* =========================================
   TRENDING DISHES, ITEMS YOU LOVE, COUPON
========================================= */
.trending-section, .items-love-section, .coupon-section {
  max-width: 1300px;
  margin: 50px auto;
  padding: 0 20px;
}

.trending-header, .items-love-header, .coupon-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 25px;
}

.trending-header h2, .items-love-header h2, .coupon-header h2 {
  font-size: 28px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.trending-header p, .items-love-header p, .coupon-header p {
  color: var(--text);
  font-size: 14px;
}

/* Trending Dishes */
.trending-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
}

.trending-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px;
  display: flex;
  gap: 15px;
  align-items: center;
  transition: all 0.3s;
}

.trending-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary);
}

.trending-emoji {
  font-size: 40px;
}

.trending-info {
  flex: 1;
}

.trending-info h3 {
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 3px;
}

.trending-info p {
  font-size: 12px;
  color: var(--text);
  margin-bottom: 8px;
}

.trending-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.trending-bottom strong {
  font-size: 16px;
  color: var(--primary);
}

.trending-rating {
  font-size: 12px;
  color: #f59e0b;
  font-weight: 600;
}

/* Items You'll Love */
.items-love-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
}

.items-love-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px;
  display: flex;
  gap: 15px;
  align-items: center;
  transition: all 0.3s;
}

.items-love-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary);
}

.items-love-emoji {
  font-size: 40px;
}

.items-love-info {
  flex: 1;
}

.items-love-info h3 {
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 3px;
}

.items-love-info p {
  font-size: 12px;
  color: var(--text);
  margin-bottom: 8px;
}

.items-love-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.items-love-bottom strong {
  font-size: 16px;
  color: var(--primary);
}

.items-love-add {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 5px 10px;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

/* Coupon Section */
.coupon-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
}

.coupon-card {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  border-radius: 16px;
  padding: 20px;
  display: flex;
  gap: 20px;
  align-items: center;
  color: var(--white);
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}

.coupon-card::before {
  content: '';
  position: absolute;
  top: 50%;
  left: -10px;
  width: 20px;
  height: 20px;
  background: var(--bg);
  border-radius: 50%;
  transform: translateY(-50%);
}

.coupon-card::after {
  content: '';
  position: absolute;
  top: 50%;
  right: -10px;
  width: 20px;
  height: 20px;
  background: var(--bg);
  border-radius: 50%;
  transform: translateY(-50%);
}

.coupon-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 2px dashed rgba(255, 255, 255, 0.4);
  padding-right: 20px;
  min-width: 110px;
}

.coupon-code {
  font-size: 18px;
  font-weight: 900;
  letter-spacing: 1px;
  margin-bottom: 5px;
}

.coupon-discount {
  background: #ffd166;
  color: #1a202c;
  padding: 3px 8px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
}

.coupon-right {
  flex: 1;
}

.coupon-right p {
  font-size: 13px;
  margin-bottom: 10px;
}

.coupon-apply {
  background: var(--white);
  color: var(--primary);
  border: none;
  padding: 8px 14px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
}

/* Responsive */
@media (max-width: 768px) {
  .trending-grid, .items-love-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .trending-card, .items-love-card {
    padding: 12px;
  }
  .trending-emoji, .items-love-emoji {
    font-size: 30px;
  }
  .coupon-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .trending-grid, .items-love-grid {
    grid-template-columns: 1fr;
  }
}/* =========================================
   RESTAURANT SIGNUP STEPS CSS
========================================= */
.restaurant-signup-card {
  max-height: 90vh;
  overflow-y: auto;
}

.signup-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 25px;
  gap: 8px;
}

.signup-step {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  color: var(--white);
  font-weight: 700;
  font-size: 13px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  border: 2px solid rgba(255, 255, 255, 0.3);
}

.signup-step.active {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  border-color: #13a89e;
  box-shadow: 0 0 15px rgba(19, 168, 158, 0.5);
}

.signup-step-line {
  width: 40px;
  height: 3px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3px;
  transition: all 0.3s;
}

.signup-step-line.active {
  background: #13a89e;
}

.signup-row {
  display: flex;
  gap: 12px;
}

.signup-row .form-group {
  flex: 1;
}

.signup-btn-group {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.signup-back-btn {
  background: rgba(255, 255, 255, 0.1);
  color: var(--white);
  border: 1px solid rgba(255, 255, 255, 0.3);
  padding: 15px;
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
  flex: 1;
}

.signup-btn-group .login-submit-button {
  flex: 2;
  margin-top: 0;
}

.signup-note {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
  margin-top: 15px;
  line-height: 1.5;
}

.premium-login-card .form-group textarea {
  width: 100%;
  padding: 14px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 10px;
  font-size: 14px;
  background: rgba(255, 255, 255, 0.1);
  color: var(--white);
  outline: none;
  font-family: inherit;
  resize: vertical;
}

.premium-login-card .form-group textarea::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

.premium-login-card .form-group textarea:focus {
  border-color: #13a89e;
  background: rgba(255, 255, 255, 0.2);
}

.premium-login-card .form-group input[type="time"],
.premium-login-card .form-group input[type="number"] {
  width: 100%;
  padding: 14px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 10px;
  font-size: 14px;
  background: rgba(255, 255, 255, 0.1);
  color: var(--white);
  outline: none;
}/* =========================================
   ADMIN RESTAURANT MANAGEMENT CSS
========================================= */
.pending-badge {
  background: #dc2626;
  color: var(--white);
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 20px;
  margin-left: 6px;
}

.admin-restaurants {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

.admin-restaurants h2 {
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 20px;
}

.restaurant-section {
  margin-bottom: 30px;
}

.section-heading {
  font-size: 18px;
  color: var(--text-dark);
  margin-bottom: 15px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border);
}

.admin-restaurant-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 20px;
}

.admin-restaurant-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px;
  box-shadow: var(--shadow);
  transition: all 0.3s;
}

.admin-restaurant-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
}

.admin-restaurant-card.pending {
  border-left: 4px solid #f59e0b;
}

.admin-restaurant-card.rejected {
  border-left: 4px solid #dc2626;
  opacity: 0.8;
}

.restaurant-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.restaurant-card-header strong {
  font-size: 16px;
  color: var(--text-dark);
}

.status-badge {
  font-size: 10px;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 20px;
  letter-spacing: 0.5px;
}

.status-badge.pending {
  background: #fef3c7;
  color: #92400e;
}

.status-badge.approved,
.status-badge.online {
  background: #dcfce7;
  color: #166534;
}

.status-badge.offline {
  background: #fee2e2;
  color: #991b1b;
}

.status-badge.busy {
  background: #fed7aa;
  color: #9a3412;
}

.status-badge.rejected {
  background: #fee2e2;
  color: #991b1b;
}

.restaurant-card-info {
  margin-bottom: 15px;
}

.restaurant-card-info p {
  font-size: 13px;
  color: var(--text);
  margin-bottom: 6px;
  line-height: 1.5;
}

.restaurant-card-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.approve-btn,
.reject-btn,
.status-change-btn,
.delete-btn {
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
}

.approve-btn {
  background: #16a34a;
  color: var(--white);
}

.approve-btn:hover {
  background: #15803d;
}

.reject-btn {
  background: #dc2626;
  color: var(--white);
}

.reject-btn:hover {
  background: #b91c1c;
}

.status-change-btn {
  background: var(--bg);
  color: var(--text-dark);
  border: 1px solid var(--border);
  font-size: 11px;
}

.status-change-btn:hover {
  background: var(--primary-light);
  color: var(--primary);
}

.delete-btn {
  background: #fee2e2;
  color: #dc2626;
}

.delete-btn:hover {
  background: #fecaca;
}

/* Dark Mode Fix */
.dark .admin-restaurant-card {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .restaurant-card-header strong,
.dark .admin-restaurants h2,
.dark .section-heading {
  color: var(--text-dark);
}

.dark .status-change-btn {
  background: var(--bg);
  color: var(--text-dark);
}

@media (max-width: 768px) {
  .admin-restaurant-list {
    grid-template-columns: 1fr;
  }
}/* =========================================
   RESTAURANT PANEL FULL CSS
========================================= */
.restaurant-status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-right: 6px;
}

.restaurant-status-dot.online {
  background: #16a34a;
}

.restaurant-status-dot.offline {
  background: #dc2626;
}

.restaurant-status-dot.busy {
  background: #f59e0b;
}

.status-toggle-btn {
  padding: 8px 14px;
  border-radius: 30px;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text-dark);
  transition: all 0.3s;
}

.status-toggle-btn.online {
  background: #16a34a;
  color: var(--white);
  border-color: #16a34a;
}

.menu-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.add-food-form {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 25px;
  box-shadow: var(--shadow);
}

.form-row {
  display: flex;
  gap: 15px;
  margin-bottom: 15px;
}

.form-row .form-group {
  flex: 1;
}

.add-food-btn {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 12px 24px;
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
  font-size: 14px;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 15px;
}

.menu-item-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 15px;
  display: flex;
  gap: 12px;
  align-items: center;
  transition: all 0.3s;
}

.menu-item-card.unavailable {
  opacity: 0.6;
  background: var(--bg);
}

.menu-item-emoji {
  font-size: 36px;
}

.menu-item-info {
  flex: 1;
}

.menu-item-info h4 {
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.menu-item-info p {
  font-size: 12px;
  color: var(--text);
  margin-bottom: 6px;
}

.menu-item-price strong {
  color: var(--primary);
  font-size: 15px;
  margin-right: 6px;
}

.menu-item-price del {
  color: var(--text);
  font-size: 12px;
}

.menu-item-actions {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.avail-btn {
  padding: 5px 8px;
  border-radius: 6px;
  font-size: 10px;
  font-weight: 700;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text-dark);
  cursor: pointer;
}

.avail-btn.active {
  background: #dcfce7;
  color: #166534;
  border-color: #86efac;
}

.settings-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  box-shadow: var(--shadow);
  max-width: 600px;
}

.settings-card .form-group input {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 14px;
  outline: none;
  background: var(--bg);
}

/* Dark Mode */
.dark .add-food-form,
.dark .menu-item-card,
.dark .settings-card {
  background: var(--white);
}

.dark .menu-item-info h4 {
  color: var(--text-dark);
}

.dark .settings-card .form-group input {
  background: var(--bg);
  color: var(--text-dark);
}

@media (max-width: 768px) {
  .form-row {
    flex-direction: column;
  }
  .menu-grid {
    grid-template-columns: 1fr;
  }
}/* =========================================
   FOOD IMAGE UPLOAD CSS (Professional)
========================================= */
.image-upload-area {
  margin-top: 6px;
}

.image-upload-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--primary-light);
  color: var(--primary);
  padding: 14px 22px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  border: 2px dashed var(--primary);
  transition: all 0.3s;
}

.image-upload-btn:hover {
  background: var(--primary);
  color: var(--white);
}

.image-upload-btn input {
  display: none;
}

.image-preview-wrapper {
  position: relative;
  display: inline-block;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  max-width: 350px;
  width: 100%;
  background: var(--bg);
}

.food-image-preview {
  display: block;
  width: 100%;
  height: auto;
  max-height: 350px;
  object-fit: contain;
  background: var(--bg);
  border-radius: 12px;
}

.remove-image-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  background: #dc2626;
  color: var(--white);
  border: none;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}

/* Menu Item Image (Card-এ বড়) */
.menu-item-image {
  width: 80px;
  height: 80px;
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-item-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.no-food-image {
  font-size: 32px;
}

/* Dark Mode */
.dark .image-upload-btn {
  background: var(--bg);
  color: var(--primary);
  border-color: var(--primary);
}

.dark .image-upload-btn:hover {
  background: var(--primary);
  color: var(--white);
}/* =========================================
   IMAGE CROPPER FIX (Important!)
========================================= */
.image-cropper-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.9);
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.image-cropper-content {
  background: var(--white);
  border-radius: 20px;
  width: 100%;
  max-width: 700px;
  max-height: 95vh;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
}

.cropper-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 20px;
  border-bottom: 1px solid var(--border);
  background: var(--white);
  position: sticky;
  top: 0;
  z-index: 10;
}

.cropper-header h2 {
  font-size: 20px;
  color: var(--text-dark);
}

.cropper-close-btn {
  background: transparent;
  border: none;
  font-size: 22px;
  cursor: pointer;
  color: var(--text);
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cropper-close-btn:hover {
  background: #fee2e2;
  color: #dc2626;
}

/* ⚠️ এইটাই সবচেয়ে গুরুত্বপূর্ণ - Cropper Area-র Height */
.cropper-area {
  position: relative;
  width: 100%;
  height: 400px !important;
  min-height: 400px !important;
  background: #000;
  overflow: hidden;
}

/* react-easy-crop-এর Container ঠিক করা */
.cropper-area > div {
  position: absolute !important;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100% !important;
  height: 100% !important;
}

/* react-easy-crop-এর Image ঠিক করা */
.cropper-area img {
  max-width: none !important;
  max-height: none !important;
}

.cropper-controls {
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.cropper-control-group label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 8px;
}

.aspect-buttons {
  display: flex;
  gap: 8px;
}

.aspect-btn {
  flex: 1;
  padding: 10px;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text-dark);
  border-radius: 8px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s;
}

.aspect-btn.active {
  background: var(--primary);
  color: var(--white);
  border-color: var(--primary);
}

.cropper-slider {
  width: 100%;
  accent-color: var(--primary);
}

.cropper-actions {
  display: flex;
  gap: 10px;
  padding: 18px 20px;
  border-top: 1px solid var(--border);
  background: var(--white);
}

.cropper-cancel-btn {
  flex: 1;
  padding: 12px;
  background: var(--bg);
  color: var(--text-dark);
  border: 1px solid var(--border);
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
}

.cropper-save-btn {
  flex: 2;
  padding: 12px;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  border: none;
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
  font-size: 14px;
}

.recrop-image-btn {
  position: absolute;
  bottom: 8px;
  left: 8px;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 6px 12px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
}

.image-preview-wrapper .food-image-preview {
  width: 300px;
  height: 300px;
  object-fit: cover;
  border-radius: 12px;
  display: block;
}

@media (max-width: 768px) {
  .cropper-area {
    height: 300px !important;
    min-height: 300px !important;
  }
  .image-preview-wrapper .food-image-preview {
    width: 100%;
    height: auto;
  }
}/* =========================================
   FOOD IMAGE PREVIEW CSS (Full Picture)
========================================= */
.image-upload-area {
  margin-top: 6px;
}

.image-upload-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--primary-light);
  color: var(--primary);
  padding: 14px 22px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  border: 2px dashed var(--primary);
  transition: all 0.3s;
}

.image-upload-btn:hover {
  background: var(--primary);
  color: var(--white);
}

.image-upload-btn input {
  display: none;
}

.image-preview-wrapper {
  position: relative;
  display: inline-block;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  max-width: 100%;
}

.food-image-preview {
  width: 350px;
  max-width: 100%;
  height: auto;
  display: block;
  border-radius: 12px;
  background: var(--bg);
  object-fit: contain;
}

.remove-image-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  background: #dc2626;
  color: var(--white);
  border: none;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  cursor: pointer;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
}

/* Menu Item Image */
.menu-item-image {
  width: 80px;
  height: 80px;
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-item-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.no-food-image {
  font-size: 32px;
}

/* Dark Mode */
.dark .image-upload-btn {
  background: var(--bg);
  color: var(--primary);
  border-color: var(--primary);
}

.dark .image-upload-btn:hover {
  background: var(--primary);
  color: var(--white);
}/* =========================================
   FOOD IMAGE PREVIEW - FORCE FIX
========================================= */
.image-preview-wrapper {
  position: relative !important;
  display: inline-block !important;
  border-radius: 12px !important;
  overflow: hidden !important;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15) !important;
  max-width: 350px !important;
  width: 100% !important;
  background: var(--bg) !important;
}

.food-image-preview {
  display: block !important;
  width: 100% !important;
  height: auto !important;
  max-height: 350px !important;
  max-width: 350px !important;
  object-fit: contain !important;
  background: var(--bg) !important;
  border-radius: 12px !important;
}

.remove-image-btn {
  position: absolute !important;
  top: 8px !important;
  right: 8px !important;
  background: #dc2626 !important;
  color: #ffffff !important;
  border: none !important;
  width: 28px !important;
  height: 28px !important;
  border-radius: 50% !important;
  cursor: pointer !important;
  font-size: 14px !important;
  font-weight: 700 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  z-index: 10 !important;
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3) !important;
}/* =========================================
   FIREBASE RESTAURANT & FOOD IMAGE CSS
========================================= */
.restaurant-page-header {
  position: relative;
}

.restaurant-status-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--bg);
  padding: 8px 14px;
  border-radius: 30px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-dark);
}

.restaurant-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.all-restaurant-image img.restaurant-logo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.restaurant-badge.online-badge {
  background: #16a34a;
  color: var(--white);
}

.restaurant-badge.busy-badge {
  background: #f59e0b;
  color: var(--white);
}

.food-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
}

.food-price-box {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.food-price-box del {
  font-size: 11px;
  color: var(--text);
}

.dark .restaurant-status-badge {
  background: var(--bg);
  color: var(--text-dark);
}/* =========================================
   MULTIPLE RESTAURANT CART CSS
========================================= */
.cart-restaurant-group {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 18px;
  margin-bottom: 20px;
  box-shadow: var(--shadow);
}

.cart-restaurant-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 12px;
  margin-bottom: 15px;
  border-bottom: 2px solid var(--primary-light);
}

.cart-restaurant-header h3 {
  font-size: 17px;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.cart-restaurant-header small {
  font-size: 12px;
  color: var(--text);
}

.restaurant-tag {
  background: var(--primary-light);
  color: var(--primary);
  font-size: 11px;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 20px;
}

/* Dark Mode */
.dark .cart-restaurant-group {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .cart-restaurant-header h3 {
  color: var(--text-dark);
}/* =========================================
   MULTIPLE ORDER SUMMARY CSS
========================================= */
.summary-restaurant-group {
  background: var(--bg);
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 12px;
}

.summary-restaurant-group .summary-restaurant {
  margin-bottom: 10px;
  padding-bottom: 10px;
  border-bottom: 1px dashed var(--border);
}

.summary-restaurant-group .summary-items {
  margin-bottom: 8px;
}

.summary-restaurant-group .summary-item {
  font-size: 13px;
  margin-bottom: 6px;
}

.group-total {
  padding-top: 8px;
  border-top: 1px dashed var(--border);
  margin-top: 8px;
}

.group-total strong {
  color: var(--primary);
}

.order-ids-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 15px;
}

.order-id-badge {
  background: var(--primary-light);
  color: var(--primary);
  padding: 8px 14px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 14px;
}

.dark .summary-restaurant-group {
  background: var(--bg);
}

.dark .summary-restaurant-group .summary-restaurant strong {
  color: var(--text-dark);
}/* =========================================
   SINGLE RESTAURANT CART & CONFLICT MODAL
========================================= */
.conflict-modal-buttons {
  display: flex;
  gap: 10px;
  margin-top: 20px;
}

.cancel-btn {
  flex: 1;
  background: var(--bg);
  color: var(--text-dark);
  border: 1px solid var(--border);
  padding: 12px;
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
}

.confirm-btn {
  flex: 2;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  border: none;
  padding: 12px;
  border-radius: 10px;
  font-weight: 700;
  cursor: pointer;
}

.minimum-order-warning {
  background: #fef3c7;
  color: #92400e;
  padding: 10px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  text-align: center;
  margin-top: 12px;
  border: 1px solid #fcd34d;
}

.checkout-button.disabled {
  background: var(--border);
  color: var(--text);
  cursor: not-allowed;
}

/* Dark Mode */
.dark .cancel-btn {
  background: var(--bg);
  color: var(--text-dark);
}

.dark .minimum-order-warning {
  background: #78350f;
  color: #fef3c7;
  border-color: #92400e;
}/* =========================================
   CART & CHECKOUT IMAGE CSS
========================================= */
.cart-restaurant-info {
  display: flex;
  align-items: center;
  gap: 12px;
}

.cart-restaurant-logo {
  width: 45px;
  height: 45px;
  border-radius: 10px;
  overflow: hidden;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.cart-restaurant-logo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Restaurant Page Header Logo */
.restaurant-header-with-logo {
  display: flex;
  align-items: center;
  gap: 15px;
}

.restaurant-header-logo {
  width: 60px;
  height: 60px;
  border-radius: 14px;
  overflow: hidden;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  flex-shrink: 0;
  box-shadow: var(--shadow);
}

.restaurant-header-logo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Checkout Summary Restaurant Logo */
.summary-restaurant-logo {
  width: 45px;
  height: 45px;
  border-radius: 10px;
  overflow: hidden;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.summary-restaurant-logo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Summary Item with Image */
.summary-item-with-image {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
}

.summary-item-image {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  overflow: hidden;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  flex-shrink: 0;
}

.summary-item-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Dark Mode */
.dark .cart-restaurant-logo,
.dark .restaurant-header-logo,
.dark .summary-restaurant-logo,
.dark .summary-item-image {
  background: var(--bg);
}

@media (max-width: 768px) {
  .cart-restaurant-logo,
    width: 45px;
    height: 45px;
  }
  
  .restaurant-header-logo {
    width: 50px;
    height: 50px;
  }
}/* =========================================
   CART IMAGE FORCE FIX
========================================= */
.cart-restaurant-info {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
}

.cart-restaurant-logo {
  width: 50px !important;
  height: 50px !important;
  border-radius: 10px !important;
  overflow: hidden !important;
  background: var(--primary-light) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 22px !important;
  flex-shrink: 0 !important;
}

.cart-restaurant-logo img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
}
/* =========================================
   PREMIUM CART DESIGN
========================================= */
.cart-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: flex-end;
  animation: fadeIn 0.3s ease;
}

.cart-panel {
  width: 100%;
  max-width: 420px;
  background: var(--white);
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: -5px 0 25px rgba(0, 0, 0, 0.15);
  animation: slideInRight 0.3s ease;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid var(--border);
  background: var(--white);
}

.cart-header h2 {
  font-size: 22px;
  color: var(--text-dark);
  margin-top: 4px;
}

.cart-close {
  background: var(--bg);
  border: none;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 20px;
  cursor: pointer;
  color: var(--text-dark);
  transition: all 0.2s;
}

.cart-close:hover {
  background: #fee2e2;
  color: #dc2626;
}

/* Restaurant Info Header */
.cart-restaurant-info-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  background: linear-gradient(135deg, var(--primary-light), #f0fdfb);
  border-bottom: 1px solid var(--border);
}

.cart-restaurant-logo-small {
  width: 45px;
  height: 45px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
  box-shadow: 0 4px 10px rgba(19, 168, 158, 0.15);
  border: 2px solid var(--white);
}

.cart-restaurant-logo-small img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-restaurant-details strong {
  display: block;
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 3px;
  font-weight: 800;
}

.cart-restaurant-details small {
  font-size: 12px;
  color: var(--primary);
  font-weight: 600;
}

/* Quantity Control Premium */
.cart-quantity-premium {
  display: inline-flex;
  align-items: center;
  gap: 0;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 30px;
  overflow: hidden;
  width: fit-content;
  margin-top: 4px;
}

.cart-quantity-premium button {
  background: transparent;
  border: none;
  width: 30px;
  height: 30px;
  font-size: 16px;
  font-weight: 800;
  color: var(--primary);
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-quantity-premium button:hover {
  background: var(--primary);
  color: var(--white);
}

.cart-quantity-premium span {
  padding: 0 12px;
  font-size: 14px;
  font-weight: 800;
  color: var(--text-dark);
  min-width: 28px;
  text-align: center;
}


/* Cart Total */
.cart-total {
  padding: 18px 20px;
  border-top: 2px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--white);
}

.cart-total span {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.cart-total strong {
  font-size: 22px;
  color: var(--text-dark);
  font-weight: 900;
}

.checkout-button {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  border: none;
  margin: 0 20px 20px;
  padding: 16px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.3s;
  box-shadow: 0 6px 18px rgba(19, 168, 158, 0.35);
  letter-spacing: 0.3px;
}

.checkout-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(19, 168, 158, 0.45);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

/* Dark Mode */
.dark .cart-panel,
.dark .cart-header,
.dark .cart-total {
  background: var(--white);
}

.dark .cart-header h2,
.dark .cart-item-name,
.dark .cart-item-total strong,
.dark .cart-total strong {
  color: var(--text-dark);
}

.dark .cart-restaurant-info-header {
  background: linear-gradient(135deg, var(--primary-light), #0f2a28);
}

.dark .cart-restaurant-details strong {
  color: var(--text-dark);
}

.dark .cart-quantity-premium {
  background: var(--bg);
  border-color: var(--border);
}

.dark .cart-quantity-premium span {
  color: var(--text-dark);
}

/* Mobile */
@media (max-width: 500px) {
  .cart-panel {
    max-width: 100%;
  }
  
  .cart-item-name {
    font-size: 14px;
  }
  
  .cart-item-total strong {
    font-size: 14px;
  }
}/* =========================================
   CART ITEM - FINAL ONE & ONLY
========================================= */
.cart-item {
  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
  padding: 14px 0 !important;
  border-bottom: 1px solid var(--border) !important;
}
/* =========================================
   CART COMPONENT - FINAL CLEAN CSS
========================================= */

/* ১. Cart Overlay */
.cart-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: flex-end;
  animation: fadeIn 0.3s ease;
}

/* ২. Cart Panel */
.cart-panel {
  width: 100%;
  max-width: 420px;
  background: var(--white);
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: -5px 0 25px rgba(0, 0, 0, 0.15);
  animation: slideInRight 0.3s ease;
}

/* ৩. Cart Header */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

.cart-header h2 {
  font-size: 22px;
  color: var(--text-dark);
  margin-top: 4px;
}

.cart-close {
  background: var(--bg);
  border: none;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  font-size: 20px;
  cursor: pointer;
  color: var(--text-dark);
}

.cart-close:hover {
  background: #fee2e2;
  color: #dc2626;
}

/* ৪. Restaurant Info Header */
.cart-restaurant-info-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  background: linear-gradient(135deg, #e6f7f6, #f0fdfb);
  border-bottom: 1px solid var(--border);
}

.cart-restaurant-logo-small {
  width: 45px;
  height: 45px;
  border-radius: 12px;
  overflow: hidden;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
  box-shadow: 0 4px 10px rgba(19, 168, 158, 0.15);
  border: 2px solid var(--white);
}

.cart-restaurant-logo-small img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-restaurant-info-header > div:last-child {
  flex: 1;
}

.cart-restaurant-info-header strong {
  display: block;
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 3px;
  font-weight: 800;
}

.cart-restaurant-info-header small {
  font-size: 12px;
  color: var(--primary);
  font-weight: 600;
}

/* ৫. Cart Items Container */
.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 10px 20px;
}

/* ৬. Cart Item - সবচেয়ে গুরুত্বপূর্ণ */
.cart-items .cart-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
  width: 100%;
}

.cart-items .cart-item:last-child {
  border-bottom: none;
}

/* ৭. Food Image */
.cart-items .cart-item-image {
  width: 65px;
  height: 65px;
  border-radius: 12px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}

.cart-items .cart-item-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ৮. Food Info */
.cart-items .cart-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.cart-item-each-price {
  font-size: 11px;
  color: var(--text);
  margin: 0;
  font-weight: 600;
}

/* ৯. Quantity Control */
.cart-items .cart-quantity {
  display: inline-flex;
  align-items: center;
  gap: 0;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 30px;
  overflow: hidden;
  width: fit-content;
  margin-top: 2px;
}

.cart-items .cart-quantity button {
  background: transparent;
  border: none;
  width: 28px;
  height: 28px;
  font-size: 15px;
  font-weight: 800;
  color: var(--primary);
  cursor: pointer;
}

.cart-items .cart-quantity button:hover {
  background: var(--primary);
  color: var(--white);
}

.cart-items .cart-quantity span {
  padding: 0 10px;
  font-size: 13px;
  font-weight: 800;
  color: var(--text-dark);
  min-width: 24px;
  text-align: center;
}

/* ১০. Item Total Price */
.cart-item-total-price {
  font-size: 15px;
  color: var(--primary);
  font-weight: 800;
  flex-shrink: 0;
  white-space: nowrap;
}

/* ১১. Cart Total */
.cart-total {
  padding: 18px 20px;
  border-top: 2px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-total span {
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
}

.cart-total strong {
  font-size: 22px;
  color: var(--text-dark);
  font-weight: 900;
}

/* ১২. Checkout Button */
.cart-panel .checkout-button {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  border: none;
  margin: 0 20px 20px;
  padding: 16px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 6px 18px rgba(19, 168, 158, 0.35);
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}/* =========================================
   CART PAGE - FULL REDESIGN
========================================= */
.cart-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 30px 20px;
}

.cart-page-container {
  max-width: 1100px;
  margin: 0 auto;
}

/* Top Back Button */
.cart-page-top {
  margin-bottom: 20px;
}

.cart-page-back-btn {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 10px 18px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  color: var(--text-dark);
  transition: all 0.2s;
}

.cart-page-back-btn:hover {
  background: var(--primary);
  color: var(--white);
  border-color: var(--primary);
}

/* Header */
.cart-page-header {
  text-align: center;
  margin-bottom: 35px;
}

.cart-page-header h1 {
  font-size: 36px;
  color: var(--text-dark);
  margin: 8px 0;
}

.cart-page-header p {
  color: var(--text);
  font-size: 15px;
}

/* Empty Cart */
.cart-page-empty {
  background: var(--white);
  border-radius: 20px;
  padding: 60px 30px;
  text-align: center;
  box-shadow: var(--shadow);
}

.cart-page-browse-btn {
  display: inline-block;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  padding: 14px 30px;
  border-radius: 12px;
  font-weight: 700;
  text-decoration: none;
  font-size: 15px;
  box-shadow: 0 6px 18px rgba(19, 168, 158, 0.35);
}

/* 2 Column Layout */
.cart-page-layout {
  display: grid;
  grid-template-columns: 1fr 350px;
  gap: 25px;
  align-items: start;
}

/* Items Wrapper */
.cart-page-items-wrapper {
  background: var(--white);
  border-radius: 18px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

/* Restaurant Header */
.cart-page-restaurant {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 22px;
  background: linear-gradient(135deg, #e6f7f6, #f0fdfb);
  border-bottom: 1px solid var(--border);
}

.cart-page-restaurant-logo {
  width: 55px;
  height: 55px;
  min-width: 55px;
  border-radius: 14px;
  overflow: hidden;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  box-shadow: 0 4px 10px rgba(19, 168, 158, 0.15);
}

.cart-page-restaurant-logo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-page-restaurant-info {
  flex: 1;
}

.cart-page-restaurant-info h3 {
  font-size: 17px;
  color: var(--text-dark);
  margin-bottom: 4px;
  font-weight: 800;
}

.cart-page-restaurant-info small {
  font-size: 12px;
  color: var(--primary);
  font-weight: 600;
}

.cart-page-item-count {
  background: var(--white);
  color: var(--primary);
  font-size: 12px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 20px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

/* Items List */
.cart-page-items-list {
  padding: 10px 22px;
}

.cart-page-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid var(--border);
  position: relative;
}

.cart-page-item:last-child {
  border-bottom: none;
}

.cart-page-item-image {
  width: 80px;
  height: 80px;
  min-width: 80px;
  border-radius: 14px;
  overflow: hidden;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34px;
}

.cart-page-item-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-page-item-info {
  flex: 1;
  min-width: 0;
}

.cart-page-item-info h4 {
  font-size: 16px;
  color: var(--text-dark);
  font-weight: 800;
  margin-bottom: 4px;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.cart-page-item-price {
  font-size: 12px;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 8px;
}

/* Quantity Control */
.cart-page-qty {
  display: inline-flex;
  align-items: center;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 30px;
  overflow: hidden;
  width: fit-content;
}

.cart-page-qty button {
  background: transparent;
  border: none;
  width: 30px;
  height: 30px;
  font-size: 16px;
  font-weight: 800;
  color: var(--primary);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-page-qty button:hover {
  background: var(--primary);
  color: var(--white);
}

.cart-page-qty span {
  padding: 0 12px;
  font-size: 14px;
  font-weight: 800;
  color: var(--text-dark);
  min-width: 28px;
  text-align: center;
}

.cart-page-item-total {
  font-size: 17px;
  color: var(--primary);
  font-weight: 800;
  flex-shrink: 0;
  white-space: nowrap;
  min-width: 70px;
  text-align: right;
}

.cart-page-item-remove {
  background: #fee2e2;
  color: #dc2626;
  border: none;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  font-size: 16px;
  font-weight: 800;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cart-page-item-remove:hover {
  background: #dc2626;
  color: var(--white);
}

/* Summary Card */
.cart-page-summary {
  background: var(--white);
  border-radius: 18px;
  padding: 25px;
  box-shadow: var(--shadow);
  position: sticky;
  top: 100px;
}

.cart-page-summary h3 {
  font-size: 20px;
  color: var(--text-dark);
  margin-bottom: 20px;
  font-weight: 800;
}

.cart-page-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  font-size: 14px;
}

.cart-page-summary-row span {
  color: var(--text);
  font-weight: 600;
}

.cart-page-summary-row strong {
  color: var(--text-dark);
  font-weight: 700;
}

.cart-page-summary-divider {
  border-top: 1px dashed var(--border);
  margin: 15px 0;
}

.cart-page-summary-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.cart-page-summary-total span {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-dark);
}

.cart-page-summary-total strong {
  font-size: 24px;
  color: var(--primary);
  font-weight: 900;
}

.cart-page-min-warning {
  background: #fef3c7;
  color: #92400e;
  padding: 12px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  text-align: center;
  margin-bottom: 15px;
  border: 1px solid #fcd34d;
}

.cart-page-checkout-btn {
  display: block;
  width: 100%;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  border: none;
  padding: 16px;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  box-shadow: 0 6px 18px rgba(19, 168, 158, 0.35);
  transition: all 0.3s;
}

.cart-page-checkout-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(19, 168, 158, 0.45);
}

.cart-page-checkout-btn.disabled {
  background: var(--border);
  color: var(--text);
  cursor: not-allowed;
  box-shadow: none;
  transform: none;
}

/* Responsive */
@media (max-width: 900px) {
  .cart-page-layout {
    grid-template-columns: 1fr;
  }

  .cart-page-summary {
    position: static;
  }

  .cart-page-header h1 {
    font-size: 28px;
  }
}

@media (max-width: 500px) {
  .cart-page-item {
    gap: 12px;
  }

  .cart-page-item-image {
    width: 65px;
    height: 65px;
    min-width: 65px;
    font-size: 26px;
  }

  .cart-page-item-info h4 {
    font-size: 14px;
  }

  .cart-page-item-total {
    font-size: 15px;
    min-width: 60px;
  }

  .cart-page-restaurant {
    padding: 14px 16px;
  }

  .cart-page-items-list {
    padding: 8px 16px;
  }
}

/* Dark Mode */
.dark .cart-page-items-wrapper,
.dark .cart-page-summary {
  background: var(--white);
}

.dark .cart-page-restaurant {
  background: linear-gradient(135deg, var(--bg), #0f2a28);
}

.dark .cart-page-restaurant-info h3,
.dark .cart-page-summary h3,
.dark .cart-page-summary-row strong,
.dark .cart-page-summary-total strong,
.dark .cart-page-item-info h4 {
  color: var(--text-dark);
}

.dark .cart-page-back-btn {
  background: var(--white);
  color: var(--text-dark);
}

.dark .cart-page-item-remove {
  background: #450a0a;
  color: #fecaca;
}

.dark .cart-page-min-warning {
  background: #78350f;
  color: #fef3c7;
  border-color: #92400e;
}/* =========================================
   LOGO IMAGE STYLES
========================================= */
.arai-logo-image {
  width: 50px;
  height: 50px;
  object-fit: contain;
  border-radius: 12px;
  flex-shrink: 0;
}

.arai-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
}

.arai-logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.arai-logo-text .logo-title {
  font-weight: 900;
  font-size: 16px;
  letter-spacing: 0.5px;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.arai-logo-text .logo-subtitle {
  font-size: 9px;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.5px;
}

/* Dark Mode */
.dark .arai-logo-text .logo-title {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Mobile */
@media (max-width: 900px) {
  .arai-logo-image {
    width: 40px;
    height: 40px;
  }
  
  .arai-logo-text .logo-title {
    font-size: 13px;
  }
  
  .arai-logo-text .logo-subtitle {
    font-size: 8px;
  }
}/* =========================================
   FOOTER BRAND LOGO
========================================= */
.footer-brand-logo {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 15px;
}

.footer-logo-image {
  width: 55px;
  height: 55px;
  object-fit: contain;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.1);
  padding: 5px;
}

.footer-brand-logo h2 {
  font-size: 22px;
  margin: 0;
  margin-bottom: 3px;
}

.footer-slogan {
  font-size: 11px;
  color: #13a89e;
  font-weight: 600;
  letter-spacing: 0.5px;
  margin: 0 !important;
}

@media (max-width: 768px) {
  .footer-logo-image {
    width: 45px;
    height: 45px;
  }
}/* =========================================
   PREMIUM LOGIN LOGO IMAGE - FIXED
========================================= */
.premium-logo-image {
  width: 90px;
  height: 90px;
  max-width: 90px;
  max-height: 90px;
  object-fit: contain;
  margin: 0 auto 15px;
  display: block;
  border-radius: 16px;
}

.premium-login-logo {
  text-align: center;
  margin-bottom: 25px;
}

.premium-login-logo h1 {
  font-size: 26px;
  color: var(--white);
  margin-bottom: 5px;
  letter-spacing: 2px;
  font-weight: 900;
}

.premium-login-logo p {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
  letter-spacing: 0.5px;
  margin: 0;
}

@media (max-width: 500px) {
  .premium-logo-image {
    width: 75px;
    height: 75px;
    max-width: 75px;
    max-height: 75px;
  }

  .premium-login-logo h1 {
    font-size: 22px;
  }
}/* =========================================
   RIDER SIGNUP CSS
========================================= */
.rider-signup-card {
  max-height: 92vh;
  overflow-y: auto;
  max-width: 480px;
}

/* Vehicle Type Grid */
.vehicle-type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-top: 8px;
}

.vehicle-type-btn {
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  padding: 14px 8px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  color: var(--white);
  transition: all 0.3s;
  font-family: inherit;
}

.vehicle-type-btn:hover {
  background: rgba(255, 255, 255, 0.15);
}

.vehicle-type-btn.active {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  border-color: #13a89e;
  box-shadow: 0 6px 18px rgba(19, 168, 158, 0.4);
}

.vehicle-type-btn span {
  font-size: 26px;
}

.vehicle-type-btn small {
  font-size: 11px;
  font-weight: 700;
}

/* Rider Review Card */
.rider-review-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 18px;
  text-align: center;
}

.rider-review-avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36px;
  margin: 0 auto 12px;
  border: 3px solid #13a89e;
}

.rider-review-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.rider-review-card h3 {
  font-size: 18px;
  color: var(--white);
  margin-bottom: 4px;
}

.rider-review-card p {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 18px;
}

.rider-review-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 12px;
  text-align: left;
}

.rider-review-item {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 10px;
  padding: 10px 12px;
}

.rider-review-item.full {
  grid-column: span 2;
  margin-bottom: 12px;
}

.rider-review-item span {
  display: block;
  font-size: 11px;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 600;
  margin-bottom: 3px;
}

.rider-review-item strong {
  display: block;
  font-size: 13px;
  color: var(--white);
  font-weight: 700;
  word-break: break-word;
}

/* Documents Preview */
.rider-documents-review {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-top: 15px;
}

.rider-doc-thumb {
  text-align: center;
}

.rider-doc-thumb span {
  display: block;
  font-size: 11px;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
  margin-bottom: 6px;
}

.rider-doc-thumb img {
  width: 100%;
  height: 90px;
  object-fit: cover;
  border-radius: 10px;
  border: 2px solid #13a89e;
}

/* Mobile */
@media (max-width: 500px) {
  .vehicle-type-grid {
    grid-template-columns: 1fr;
  }
  .rider-review-grid {
    grid-template-columns: 1fr;
  }
  .rider-review-item.full {
    grid-column: span 1;
  }
  .rider-documents-review {
    grid-template-columns: 1fr;
  }
}/* =========================================
   PREMIUM INPUT FIELDS (Date, Time, Number)
========================================= */
.premium-login-card .form-group input[type="date"],
.premium-login-card .form-group input[type="time"],
.premium-login-card .form-group input[type="number"],
.premium-login-card .form-group input[type="tel"],
.premium-login-card .form-group input[type="text"],
.premium-login-card .form-group input[type="email"],
.premium-login-card .form-group input[type="password"],
.premium-login-card .form-group textarea {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 12px;
  font-size: 15px;
  background: rgba(255, 255, 255, 0.08);
  color: var(--white);
  outline: none;
  font-family: inherit;
  transition: all 0.3s ease;
  box-sizing: border-box;
  line-height: 1.5;
  height: 52px;
}

.premium-login-card .form-group input[type="date"]:focus,
.premium-login-card .form-group input[type="time"]:focus,
.premium-login-card .form-group input[type="number"]:focus,
.premium-login-card .form-group input[type="tel"]:focus,
.premium-login-card .form-group input[type="text"]:focus,
.premium-login-card .form-group input[type="email"]:focus,
.premium-login-card .form-group input[type="password"]:focus,
.premium-login-card .form-group textarea:focus {
  border-color: #13a89e;
  background: rgba(19, 168, 158, 0.12);
  box-shadow: 0 0 0 3px rgba(19, 168, 158, 0.15);
}

.premium-login-card .form-group input::placeholder,
.premium-login-card .form-group textarea::placeholder {
  color: rgba(255, 255, 255, 0.45);
  font-weight: 400;
}

.premium-login-card .form-group label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 8px;
  letter-spacing: 0.3px;
}

.premium-login-card .form-group input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(1);
  opacity: 0.7;
  cursor: pointer;
  padding: 4px;
  border-radius: 4px;
  transition: opacity 0.2s;
}

.premium-login-card .form-group input[type="date"]::-webkit-calendar-picker-indicator:hover {
  opacity: 1;
  background: rgba(19, 168, 158, 0.3);
}

.premium-login-card .form-group input[type="time"]::-webkit-calendar-picker-indicator {
  filter: invert(1);
  opacity: 0.7;
  cursor: pointer;
  padding: 4px;
  border-radius: 4px;
}

.premium-login-card .form-group input[type="time"]::-webkit-calendar-picker-indicator:hover {
  opacity: 1;
  background: rgba(19, 168, 158, 0.3);
}

.premium-login-card .form-group input[type="number"]::-webkit-inner-spin-button,
.premium-login-card .form-group input[type="number"]::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.premium-login-card .form-group input[type="number"] {
  -moz-appearance: textfield;
  appearance: textfield;
}

.premium-login-card .form-group textarea {
  height: auto;
  min-height: 70px;
  resize: vertical;
  line-height: 1.5;
  padding: 14px 16px;
}

.premium-login-card .form-group {
  margin-bottom: 18px;
}/* =========================================
   ADMIN RIDER MANAGEMENT CSS
========================================= */
.rider-card-content {
  display: flex;
  gap: 15px;
  margin-bottom: 15px;
  align-items: flex-start;
}

.rider-card-avatar {
  width: 70px;
  height: 70px;
  min-width: 70px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  border: 3px solid var(--primary);
}

.rider-card-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.rider-card-details {
  flex: 1;
  min-width: 0;
}

.rider-card-details p {
  font-size: 13px;
  color: var(--text);
  margin-bottom: 5px;
  word-break: break-word;
}

.view-docs-btn {
  background: #dbeafe;
  color: #1e40af;
  border: none;
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
}

.view-docs-btn:hover {
  background: #bfdbfe;
}

/* Rider Documents Modal */
.rider-documents-modal {
  background: var(--white);
  border-radius: 20px;
  padding: 25px;
  max-width: 800px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
}

.rider-documents-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding-bottom: 15px;
  border-bottom: 1px solid var(--border);
}

.rider-documents-header h2 {
  font-size: 22px;
  color: var(--text-dark);
  margin: 0;
}

.rider-documents-body {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-bottom: 20px;
}

.rider-doc-section {
  text-align: center;
}

.rider-doc-section h4 {
  font-size: 14px;
  color: var(--text-dark);
  margin-bottom: 10px;
  font-weight: 700;
}

.rider-doc-image {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: 12px;
  border: 2px solid var(--border);
  box-shadow: var(--shadow);
}

.rider-doc-section p {
  color: var(--text);
  font-size: 13px;
  padding: 20px;
  background: var(--bg);
  border-radius: 8px;
}

.rider-documents-actions {
  display: flex;
  gap: 12px;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}

.rider-documents-actions button {
  flex: 1;
  padding: 14px;
  font-size: 14px;
  border-radius: 10px;
}

/* Dark Mode */
.dark .rider-documents-modal {
  background: var(--white);
}

.dark .rider-documents-header h2 {
  color: var(--text-dark);
}

.dark .rider-doc-section h4 {
  color: var(--text-dark);
}

@media (max-width: 768px) {
  .rider-documents-body {
    grid-template-columns: 1fr;
  }
  .rider-doc-image {
    height: 180px;
  }
}/* =========================================
   RIDER PANEL FULL CSS
========================================= */
.rider-header-avatar {
  width: 55px;
  height: 55px;
  min-width: 55px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  border: 3px solid var(--primary);
}

.rider-header-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.rider-status-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  margin-right: 6px;
}

.rider-status-dot.online { background: #16a34a; }
.rider-status-dot.offline { background: #dc2626; }

.rider-online-toggle {
  padding: 8px 16px;
  border-radius: 30px;
  font-weight: 800;
  font-size: 13px;
  cursor: pointer;
  border: 2px solid #dc2626;
  background: #ffffff;
  color: #dc2626;
  transition: all 0.3s;
}

.rider-online-toggle.online {
  background: #16a34a;
  color: #ffffff;
  border-color: #16a34a;
}

/* Delivery Status Flow */
.delivery-status-flow {
  margin-top: 15px;
  padding-top: 15px;
  border-top: 1px dashed var(--border);
}

.delivery-status-steps {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 15px;
}

.delivery-step {
  padding: 8px 12px;
  border-radius: 8px;
  background: var(--bg);
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  border-left: 3px solid var(--border);
}

.delivery-step.active {
  background: #dcfce7;
  color: #166534;
  border-left-color: #16a34a;
  font-weight: 700;
}

.delivery-next-btn-wrap button {
  width: 100%;
}

.otp-verification-box {
  background: #fef3c7;
  border: 2px dashed #f59e0b;
  border-radius: 12px;
  padding: 15px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.otp-verification-box label {
  font-size: 13px;
  font-weight: 800;
  color: #92400e;
}

.otp-verification-box input {
  width: 100%;
  padding: 12px;
  border: 2px solid #f59e0b;
  border-radius: 10px;
  font-size: 22px;
  text-align: center;
  letter-spacing: 8px;
  font-weight: 900;
  outline: none;
  background: #ffffff;
  color: #1a202c;
}

.delivered-label-wrap {
  margin-top: 15px;
  text-align: center;
}

/* Rider Profile View */
.rider-profile-view {
  background: var(--white);
  border-radius: 18px;
  padding: 30px;
  text-align: center;
  box-shadow: var(--shadow);
  max-width: 700px;
  margin: 0 auto;
}

.rider-profile-avatar-large {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50px;
  margin: 0 auto 15px;
  border: 4px solid var(--primary);
}

.rider-profile-avatar-large img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.rider-profile-view h3 {
  font-size: 22px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.rider-profile-email {
  color: var(--text);
  font-size: 14px;
  margin-bottom: 25px;
}

.rider-profile-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  text-align: left;
}

.rider-profile-item {
  background: var(--bg);
  border-radius: 10px;
  padding: 12px 15px;
}

.rider-profile-item.full {
  grid-column: span 2;
}

.rider-profile-item span {
  display: block;
  font-size: 12px;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 4px;
}

.rider-profile-item strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
  font-weight: 700;
  word-break: break-word;
}

/* Dark Mode */
.dark .rider-profile-view {
  background: var(--white);
}

.dark .rider-profile-view h3,
.dark .rider-profile-item strong {
  color: var(--text-dark);
}

.dark .rider-profile-item {
  background: var(--bg);
}

.dark .otp-verification-box {
  background: #78350f;
  border-color: #f59e0b;
}

.dark .otp-verification-box label {
  color: #fef3c7;
}

.dark .delivery-step {
  background: var(--bg);
}

.dark .delivery-step.active {
  background: #052e16;
  color: #86efac;
}

@media (max-width: 600px) {
  .rider-profile-grid {
    grid-template-columns: 1fr;
  }
  .rider-profile-item.full {
    grid-column: span 1;
  }
}/* =========================================
   RIDER PROFILE EDIT CSS
========================================= */
.rider-profile-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 700px;
  margin: 0 auto 15px;
}

.edit-profile-btn {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  border: none;
  padding: 10px 18px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  box-shadow: 0 4px 12px rgba(19, 168, 158, 0.35);
  transition: all 0.3s;
}

.edit-profile-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(19, 168, 158, 0.45);
}

/* Profile Photo Edit */
.profile-photo-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 15px;
}

.profile-photo-change-btn {
  background: var(--primary-light);
  color: var(--primary);
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  margin-top: 12px;
  border: 2px solid var(--primary);
  transition: all 0.2s;
}

.profile-photo-change-btn:hover {
  background: var(--primary);
  color: var(--white);
}

.profile-photo-change-btn input {
  display: none;
}

.rider-profile-locked {
  font-size: 12px;
  color: var(--text);
  background: var(--bg);
  padding: 8px 14px;
  border-radius: 8px;
  display: inline-block;
  margin-bottom: 20px;
}

/* Profile Edit Inputs */
.rider-profile-item input,
.rider-profile-item select,
.rider-profile-item textarea {
  width: 100%;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 13px;
  outline: none;
  background: var(--white);
  color: var(--text-dark);
  font-family: inherit;
  box-sizing: border-box;
}

.rider-profile-item input:focus,
.rider-profile-item select:focus,
.rider-profile-item textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(19, 168, 158, 0.15);
}

/* Profile Edit Actions */
.rider-profile-edit-actions {
  display: flex;
  gap: 12px;
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}

.rider-profile-edit-actions .cancel-btn,
.rider-profile-edit-actions .save-btn {
  flex: 1;
  padding: 14px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 14px;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
}

.rider-profile-edit-actions .cancel-btn {
  background: var(--bg);
  color: var(--text-dark);
  border: 1px solid var(--border);
}

.rider-profile-edit-actions .save-btn {
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  box-shadow: 0 4px 12px rgba(19, 168, 158, 0.35);
}

.rider-profile-edit-actions .save-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Dark Mode */
.dark .rider-profile-item input,
.dark .rider-profile-item select,
.dark .rider-profile-item textarea {
  background: var(--bg);
  color: var(--text-dark);
}

.dark .rider-profile-locked {
  background: var(--bg);
  color: var(--text);
}/* =========================================
   PANEL LOADING STATE
========================================= */
.panel-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  text-align: center;
  padding: 40px 20px;
}

.panel-loading-spinner {
  width: 50px;
  height: 50px;
  border: 4px solid var(--border);
  border-top-color: #13a89e;
  border-radius: 50%;
  animation: spinLoading 0.8s linear infinite;
  margin-bottom: 20px;
}

@keyframes spinLoading {
  to { transform: rotate(360deg); }
}

.panel-loading p {
  font-size: 15px;
  color: var(--text);
  font-weight: 600;
}

.dark .panel-loading-spinner {
  border-color: var(--border);
  border-top-color: #13a89e;
}

.dark .panel-loading p {
  color: var(--text);
}/* =========================================
   PANEL ERROR STATE
========================================= */
.panel-error-box {
  max-width: 500px;
  margin: 80px auto;
  background: var(--white);
  border-radius: 20px;
  padding: 40px;
  text-align: center;
  box-shadow: var(--shadow-lg);
}

.panel-error-icon {
  font-size: 70px;
  margin-bottom: 20px;
}

.panel-error-box h2 {
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 12px;
}

.panel-error-box p {
  font-size: 15px;
  color: var(--text);
  line-height: 1.6;
  margin-bottom: 25px;
}

.panel-error-actions {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}

.panel-error-actions button {
  padding: 12px 20px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  border: none;
}

.panel-error-actions .account-home-btn {
  background: var(--bg);
  color: var(--text-dark);
  border: 1px solid var(--border);
}

.panel-error-actions .restaurant-logout-btn {
  background: #fee2e2;
  color: #dc2626;
}

.dark .panel-error-box {
  background: var(--white);
}

.dark .panel-error-box h2 {
  color: var(--text-dark);
}/* =========================================
   ORDER HISTORY FIREBASE CSS
========================================= */
.order-history-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
  max-width: 750px;
  margin: 0 auto;
}

.order-history-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 20px;
  box-shadow: var(--shadow);
  transition: all 0.3s;
}

.order-history-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-lg);
  border-color: var(--primary);
}

.order-history-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 15px;
  padding-bottom: 15px;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
  gap: 10px;
}

.order-history-header strong {
  display: block;
  font-size: 15px;
  color: var(--text-dark);
  margin-bottom: 4px;
  font-weight: 800;
}

.order-history-header small {
  font-size: 12px;
  color: var(--text);
  font-weight: 600;
}

.order-status-badge {
  padding: 6px 14px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

.order-history-restaurant {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 15px;
  padding: 12px;
  background: var(--primary-light);
  border-radius: 12px;
}

.order-history-logo {
  width: 45px;
  height: 45px;
  min-width: 45px;
  border-radius: 10px;
  overflow: hidden;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
}

.order-history-logo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.order-history-restaurant strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
  margin-bottom: 3px;
  font-weight: 800;
}

.order-history-restaurant small {
  font-size: 12px;
  color: var(--text);
  font-weight: 600;
}

.order-history-items {
  margin-bottom: 15px;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 0;
  font-size: 13px;
  color: var(--text);
}

.history-quantity {
  font-weight: 700;
  color: var(--text-dark);
}

.order-history-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12px;
  border-top: 1px dashed var(--border);
  margin-bottom: 15px;
}

.order-history-total span {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}

.order-history-total strong {
  font-size: 18px;
  color: var(--primary);
  font-weight: 900;
}

.order-history-actions {
  display: flex;
  gap: 10px;
}

.order-history-actions .track-order-button {
  flex: 1;
  background: linear-gradient(135deg, #13a89e, #0e7f78);
  color: var(--white);
  border: none;
  padding: 12px;
  border-radius: 10px;
  font-weight: 800;
  font-size: 14px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  box-shadow: 0 4px 12px rgba(19, 168, 158, 0.35);
  transition: all 0.3s;
}

.order-history-actions .track-order-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(19, 168, 158, 0.45);
}

/* Dark Mode */
.dark .order-history-card {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .order-history-header strong,
.dark .order-history-restaurant strong {
  color: var(--text-dark);
}

.dark .order-history-restaurant {
  background: var(--bg);
}

.dark .order-history-logo {
  background: var(--white);
}

@media (max-width: 600px) {
  .order-history-header {
    flex-direction: column;
    align-items: flex-start;
  }
}/* =========================================
   MAP LOADING SKELETON
========================================= */
.map-picker-wrapper {
  width: 100%;
  position: relative;
}

.google-map-container {
  width: 100%;
  height: 400px;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  background: #e6f7f6;
}

.map-loading-skeleton {
  width: 100%;
  height: 400px;
  border-radius: 16px;
  background: linear-gradient(135deg, #e6f7f6, #f0fdfb);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 15px;
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}

.map-loading-skeleton::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  to { left: 100%; }
}

.map-loading-spinner {
  width: 40px;
  height: 40px;
  border: 4px solid rgba(19, 168, 158, 0.2);
  border-top-color: #13a89e;
  border-radius: 50%;
  animation: spinLoading 0.8s linear infinite;
}

.map-loading-skeleton p {
  font-size: 14px;
  font-weight: 700;
  color: #13a89e;
  z-index: 2;
}

.map-loading-skeleton.error {
  background: #fee2e2;
  border-color: #fecaca;
}

.map-loading-skeleton.error p {
  color: #dc2626;
}

.selected-location-box {
  background: var(--primary-light);
  color: var(--text-dark);
  padding: 12px;
  border-radius: 12px;
  margin-top: 12px;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  gap: 8px;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.selected-location-box strong {
  color: #13a89e;
}

@media (max-width: 768px) {
  .google-map-container,
  .map-loading-skeleton {
    height: 300px;
  }
}/* =========================================
   TRACK ORDER DETAILS CSS
========================================= */
.track-order-details {
  margin-top: 25px;
  text-align: left;
  background: var(--bg);
  border-radius: 15px;
  padding: 20px;
  border: 1px solid var(--border);
}

.track-detail-section {
  margin-bottom: 20px;
  padding-bottom: 15px;
  border-bottom: 1px dashed var(--border);
}

.track-detail-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.track-detail-section h3 {
  font-size: 14px;
  color: var(--primary);
  font-weight: 800;
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.track-detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
  color: var(--text);
  padding: 5px 0;
  gap: 10px;
}

.track-detail-row span {
  word-break: break-word;
}

.track-detail-row strong {
  color: var(--text-dark);
  font-weight: 700;
  white-space: nowrap;
}

.total-row {
  border-top: 1px solid var(--border);
  margin-top: 8px;
  padding-top: 10px;
  font-size: 16px;
}

.total-row strong {
  color: #13a89e;
  font-size: 18px;
  font-weight: 900;
}

/* Dark Mode */
.dark .track-order-details {
  background: var(--bg);
  border: 1px solid var(--border);
}

.dark .track-detail-row strong {
  color: var(--text-dark);
}

/* Mobile */
@media (max-width: 600px) {
  .track-detail-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  .track-detail-row strong {
    white-space: normal;
  }

@keyframes notifFlash {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.25); background: #ffd166; }
}

/* Dropdown — Fixed Position */

@keyframes dropdownSlide {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

.old-notification-header {
  background: linear-gradient(135deg, #13a89e, #0e7f78) !important;
  color: #ffffff !important;
  padding: 14px 16px !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  flex-shrink: 0 !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
}

.old-notification-header strong {
  font-size: 15px !important;
  display: block !important;
  margin-bottom: 3px !important;
  color: #ffffff !important;
}

.old-notification-header .old-notification-time {
  font-size: 11px !important;
  opacity: 0.85 !important;
  font-weight: 600 !important;
  color: #ffffff !important;
}

.old-notification-header-actions {
  display: flex !important;
  gap: 6px !important;
}

.mark-all-read-btn,
.clear-all-btn {
  background: rgba(255, 255, 255, 0.2) !important;
  color: #ffffff !important;
  border: 1px solid rgba(255, 255, 255, 0.3) !important;
  padding: 5px 10px !important;
  border-radius: 6px !important;
  font-size: 10px !important;
  font-weight: 700 !important;
  cursor: pointer !important;
}

.mark-all-read-btn:hover {
  background: #16a34a !important;
  border-color: #16a34a !important;
}

.clear-all-btn:hover {
  background: #dc2626 !important;
  border-color: #dc2626 !important;
}

.no-notifications {
  text-align: center !important;
  color: #4a5568 !important;
  padding: 40px 20px !important;
}

.no-notifications p {
  font-size: 14px !important;
  font-weight: 700 !important;
  color: #1a202c !important;
  margin-bottom: 4px !important;
}

.no-notifications small {
  font-size: 12px !important;
  color: #4a5568 !important;
}

.old-notification-icon-wrap {
  width: 38px !important;
  height: 38px !important;
  min-width: 38px !important;
  border-radius: 10px !important;
  background: #ffffff !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 18px !important;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08) !important;
}

.old-notification-content {
  flex: 1 !important;
  min-width: 0 !important;
}

.old-notification-content strong {
  display: block !important;
  font-size: 13px !important;
  color: #1a202c !important;
  font-weight: 800 !important;
  margin-bottom: 3px !important;
  line-height: 1.3 !important;
  word-break: break-word !important;
}

.old-notification-content p {
  font-size: 12px !important;
  color: #4a5568 !important;
  margin: 0 0 5px 0 !important;
  line-height: 1.4 !important;
  word-break: break-word !important;
}

.old-notification-content small {
  font-size: 10px !important;
  color: #4a5568 !important;
  font-weight: 600 !important;
}

.old-notification-actions {
  display: flex !important;
  flex-direction: column !important;
  gap: 4px !important;
  opacity: 0 !important;
  transition: opacity 0.2s !important;
}

.old-notification-item:hover .old-notification-actions {
  opacity: 1 !important;
}

.notif-action-btn {
  width: 22px !important;
  height: 22px !important;
  border-radius: 50% !important;
  border: none !important;
  font-size: 12px !important;
  font-weight: 800 !important;
  cursor: pointer !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.notif-action-btn.read-btn {
  background: #dcfce7 !important;
  color: #166534 !important;
}

.notif-action-btn.read-btn:hover {
  background: #16a34a !important;
  color: #fff !important;
}

.notif-action-btn.delete-btn {
  background: #fee2e2 !important;
  color: #dc2626 !important;
}

.notif-action-btn.delete-btn:hover {
  background: #dc2626 !important;
  color: #fff !important;
}

.old-notification-footer {
  padding: 8px 14px !important;
  text-align: center !important;
  background: #f8fafc !important;
  border-top: 1px solid #e2e8f0 !important;
  color: #4a5568 !important;
  font-size: 11px !important;
  font-weight: 600 !important;
}

/* Mobile */
@media (max-width: 600px) {

  .old-notification-actions {
    opacity: 1 !important;
  }
}/* =========================================
   NOTIFICATION PANEL — COMPLETE FINAL CSS
========================================= */
.old-notification-wrapper {
  position: relative !important;
  display: inline-flex !important;
  align-items: center !important;
  z-index: 99999 !important;
}

.old-nav-notification-button {
  background: transparent !important;
  border: none !important;
  font-size: 20px !important;
  cursor: pointer !important;
  color: var(--text-dark) !important;
  position: relative !important;
  padding: 6px 8px !important;
  border-radius: 50% !important;
  transition: all 0.3s ease !important;
}

.old-nav-notification-button:hover {
  background: var(--primary-light) !important;
}

.old-nav-notification-button.active {
  background: var(--primary-light) !important;
}

.old-nav-notification-button.flash {
  animation: notifFlash 0.5s ease-in-out 4 !important;
}

@keyframes notifFlash {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.25); background: #ffd166; }
}

.old-nav-notification-button .old-notification-badge {
  position: absolute !important;
  top: 0 !important;
  right: 0 !important;
  background: #dc2626 !important;
  color: #fff !important;
  font-size: 10px !important;
  font-weight: 800 !important;
  padding: 2px 6px !important;
  border-radius: 20px !important;
  min-width: 18px !important;
  height: 18px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-shadow: 0 2px 6px rgba(220, 38, 38, 0.4) !important;
}

/* =========================================
   NOTIFICATION DROPDOWN BOX
========================================= */
.old-nav-notification-box {
  position: fixed !important;
  top: 75px !important;
  right: 20px !important;
  width: 380px !important;
  max-width: 92vw !important;
  height: 520px !important;
  max-height: 80vh !important;
  background: #ffffff !important;
  border-radius: 16px !important;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25) !important;
  z-index: 999999 !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
  border: 1px solid #e2e8f0 !important;
  animation: dropdownSlide 0.25s ease-out !important;
}

@keyframes dropdownSlide {
  from { opacity: 0; transform: translateY(-10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* =========================================
   NOTIFICATION HEADER
========================================= */
.old-notification-header {
  background: linear-gradient(135deg, #13a89e, #0e7f78) !important;
  color: #ffffff !important;
  padding: 14px 16px !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  flex-shrink: 0 !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
}

.old-notification-header strong {
  font-size: 15px !important;
  display: block !important;
  margin-bottom: 3px !important;
  color: #ffffff !important;
}

.old-notification-header .old-notification-time {
  font-size: 11px !important;
  opacity: 0.85 !important;
  font-weight: 600 !important;
  color: #ffffff !important;
}

.old-notification-header-actions {
  display: flex !important;
  gap: 6px !important;
}

.mark-all-read-btn,
.clear-all-btn {
  background: rgba(255, 255, 255, 0.2) !important;
  color: #ffffff !important;
  border: 1px solid rgba(255, 255, 255, 0.3) !important;
  padding: 5px 10px !important;
  border-radius: 6px !important;
  font-size: 10px !important;
  font-weight: 700 !important;
  cursor: pointer !important;
  transition: all 0.2s !important;
}

.mark-all-read-btn:hover {
  background: #16a34a !important;
  border-color: #16a34a !important;
}

.clear-all-btn:hover {
  background: #dc2626 !important;
  border-color: #dc2626 !important;
}

/* =========================================
   NOTIFICATION LIST — SCROLLABLE
========================================= */
.old-notification-list {
  flex: 1 1 auto !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  padding: 8px !important;
  min-height: 0 !important;
  max-height: none !important;
  overscroll-behavior: contain !important;
  -webkit-overflow-scrolling: touch !important;
}

.old-notification-list::-webkit-scrollbar {
  width: 6px;
}

.old-notification-list::-webkit-scrollbar-track {
  background: #f8fafc;
}

.old-notification-list::-webkit-scrollbar-thumb {
  background: #cbd5e0 !important;
  border-radius: 3px;
}

.old-notification-list::-webkit-scrollbar-thumb:hover {
  background: #94a3b8 !important;
}

/* Empty State */
.no-notifications {
  text-align: center !important;
  color: #4a5568 !important;
  padding: 40px 20px !important;
}

.no-notifications p {
  font-size: 14px !important;
  font-weight: 700 !important;
  color: #1a202c !important;
  margin-bottom: 4px !important;
}

.no-notifications small {
  font-size: 12px !important;
  color: #4a5568 !important;
}

/* =========================================
   NOTIFICATION ITEM
========================================= */
.old-notification-item {
  display: flex !important;
  align-items: flex-start !important;
  gap: 10px !important;
  padding: 12px !important;
  border-radius: 10px !important;
  margin-bottom: 4px !important;
  background: transparent !important;
  cursor: pointer !important;
  transition: all 0.2s !important;
  position: relative !important;
}

.old-notification-item:hover {
  background: #e6f7f6 !important;
}

.old-notification-item.unread {
  background: #f0fdfb !important;
  border-left: 3px solid #13a89e !important;
}

.old-notification-item.unread:hover {
  background: #e6f7f6 !important;
}

.old-notification-icon-wrap {
  width: 38px !important;
  height: 38px !important;
  min-width: 38px !important;
  border-radius: 10px !important;
  background: #ffffff !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 18px !important;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08) !important;
  flex-shrink: 0 !important;
}

.old-notification-content {
  flex: 1 !important;
  min-width: 0 !important;
  overflow: hidden !important;
}

.old-notification-content strong {
  display: block !important;
  font-size: 13px !important;
  color: #1a202c !important;
  font-weight: 800 !important;
  margin-bottom: 3px !important;
  line-height: 1.3 !important;
  word-break: break-word !important;
}

.old-notification-content p {
  font-size: 12px !important;
  color: #4a5568 !important;
  margin: 0 0 5px 0 !important;
  line-height: 1.4 !important;
  word-break: break-word !important;
}

.old-notification-content small {
  font-size: 10px !important;
  color: #4a5568 !important;
  font-weight: 600 !important;
}

/* =========================================
   NOTIFICATION ACTIONS
========================================= */
.old-notification-actions {
  display: flex !important;
  flex-direction: column !important;
  gap: 4px !important;
  opacity: 0 !important;
  transition: opacity 0.2s !important;
  flex-shrink: 0 !important;
}

.old-notification-item:hover .old-notification-actions {
  opacity: 1 !important;
}

.notif-action-btn {
  width: 22px !important;
  height: 22px !important;
  border-radius: 50% !important;
  border: none !important;
  font-size: 12px !important;
  font-weight: 800 !important;
  cursor: pointer !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  transition: all 0.2s !important;
}

.notif-action-btn.read-btn {
  background: #dcfce7 !important;
  color: #166534 !important;
}

.notif-action-btn.read-btn:hover {
  background: #16a34a !important;
  color: #fff !important;
}

.notif-action-btn.delete-btn {
  background: #fee2e2 !important;
  color: #dc2626 !important;
}

.notif-action-btn.delete-btn:hover {
  background: #dc2626 !important;
  color: #fff !important;
}

/* =========================================
   NOTIFICATION FOOTER
========================================= */
.old-notification-footer {
  padding: 8px 14px !important;
  text-align: center !important;
  background: #f8fafc !important;
  border-top: 1px solid #e2e8f0 !important;
  color: #4a5568 !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  flex-shrink: 0 !important;
}

/* =========================================
   BODY SCROLL LOCK WHEN NOTIFICATION OPEN
========================================= */
body.notif-open {
  overflow: hidden !important;
}

/* =========================================
   DARK MODE
========================================= */
.dark .old-nav-notification-box {
  background: var(--white) !important;
  border-color: var(--border) !important;
}

.dark .old-notification-item.unread {
  background: #0f2a28 !important;
}

.dark .old-notification-item:hover {
  background: var(--bg) !important;
}

.dark .old-notification-icon-wrap {
  background: var(--bg) !important;
}

.dark .old-notification-content strong {
  color: var(--text-dark) !important;
}

.dark .old-notification-content p,
.dark .old-notification-content small {
  color: var(--text) !important;
}

.dark .old-notification-footer {
  background: var(--bg) !important;
  color: var(--text) !important;
  border-color: var(--border) !important;
}

.dark .old-notification-list::-webkit-scrollbar-track {
  background: var(--bg);
}

.dark .old-notification-list::-webkit-scrollbar-thumb {
  background: var(--border) !important;
}

/* =========================================
   MOBILE RESPONSIVE
========================================= */
@media (max-width: 600px) {
  .old-nav-notification-box {
    width: 95vw !important;
    right: 2.5vw !important;
    top: 70px !important;
    height: 70vh !important;
    max-height: 70vh !important;
  }

  .old-notification-item {
    padding: 10px !important;
  }

  .old-notification-icon-wrap {
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    font-size: 16px !important;
  }

  .old-notification-actions {
    opacity: 1 !important;
  }

  .old-notification-header {
    padding: 12px !important;
  }

  .old-notification-header strong {
    font-size: 14px !important;
  }
}

@media (max-width: 400px) {
  .old-nav-notification-box {
    width: 98vw !important;
    right: 1vw !important;
  }
}/* =========================================
   NOTIFICATION BOX — SIMPLE FIX
========================================= */
.old-nav-notification-box {
  position: fixed;
  top: 70px;
  right: 15px;
  width: 360px;
  max-width: calc(100vw - 30px);
  height: 500px;
  max-height: calc(100vh - 90px);
  background: #ffffff;
  border-radius: 14px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  z-index: 99999;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #e2e8f0;
}

.old-notification-list {
  flex: 1;
  overflow-y: auto;
  padding: 10px;
  min-height: 0;
}

@media (max-width: 600px) {
  .old-nav-notification-box {
    right: 10px;
    left: 10px;
    width: auto;
    top: 65px;
    height: calc(100vh - 130px);
  }
}/* =========================================
   NOTIFICATION BOX — FORCE FINAL OVERRIDE
   (এই CSS শেষে থাকায় সব পুরনো CSS চাপা পড়বে)
========================================= */
.old-nav-notification-box,
.old-nav-notification-box.old-nav-notification-box,
body .old-nav-notification-box {
  position: fixed !important;
  top: 70px !important;
  right: 15px !important;
  left: auto !important;
  bottom: auto !important;
  width: 360px !important;
  max-width: calc(100vw - 30px) !important;
  min-width: 0 !important;
  height: 520px !important;
  max-height: calc(100vh - 90px) !important;
  min-height: 0 !important;
  background: #ffffff !important;
  border-radius: 14px !important;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25) !important;
  z-index: 9999999 !important;
  display: flex !important;
  flex-direction: column !important;
  overflow: hidden !important;
  border: 1px solid #e2e8f0 !important;
  transform: none !important;
  margin: 0 !important;
  padding: 0 !important;
}

.old-nav-notification-box .old-notification-list {
  flex: 1 1 auto !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  padding: 8px !important;
  min-height: 0 !important;
  max-height: none !important;
  height: auto !important;
}

.old-nav-notification-box .old-notification-item {
  display: flex !important;
  align-items: flex-start !important;
  gap: 10px !important;
  padding: 12px !important;
  border-radius: 10px !important;
  margin-bottom: 4px !important;
  cursor: pointer !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.old-nav-notification-box .old-notification-content {
  flex: 1 !important;
  min-width: 0 !important;
  overflow: hidden !important;
}

.old-nav-notification-box .old-notification-content strong {
  display: block !important;
  font-size: 13px !important;
  color: #1a202c !important;
  font-weight: 800 !important;
  margin-bottom: 3px !important;
  line-height: 1.3 !important;
  word-break: break-word !important;
}

.old-nav-notification-box .old-notification-content p {
  font-size: 12px !important;
  color: #4a5568 !important;
  margin: 0 0 5px 0 !important;
  line-height: 1.4 !important;
  word-break: break-word !important;
}

.old-nav-notification-box .old-notification-header {
  background: linear-gradient(135deg, #13a89e, #0e7f78) !important;
  color: #ffffff !important;
  padding: 14px 16px !important;
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  flex-shrink: 0 !important;
  flex-wrap: wrap !important;
  gap: 8px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.old-nav-notification-box .old-notification-footer {
  padding: 8px 14px !important;
  text-align: center !important;
  background: #f8fafc !important;
  border-top: 1px solid #e2e8f0 !important;
  color: #4a5568 !important;
  font-size: 11px !important;
  font-weight: 600 !important;
  flex-shrink: 0 !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

/* Mobile */
@media (max-width: 600px) {
  .old-nav-notification-box,
  .old-nav-notification-box.old-nav-notification-box,
  body .old-nav-notification-box {
    right: 10px !important;
    left: 10px !important;
    width: auto !important;
    top: 65px !important;
    height: calc(100vh - 130px) !important;
    max-height: calc(100vh - 130px) !important;
  }
}/* =========================================
   TRACK ORDER MAP & LEGEND CSS
========================================= */
.track-map-section {
  margin-top: 25px;
  margin-bottom: 25px;
}

.map-legend {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
  margin-top: 15px;
  padding: 12px;
  background: #f8fafc;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
}

.map-legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 700;
  color: #1a202c;
}

.map-legend-icon {
  font-size: 18px;
}

.map-note {
  text-align: center;
  font-size: 13px;
  font-weight: 700;
  color: #f59e0b;
  margin-top: 12px;
  padding: 8px;
  background: #fef3c7;
  border-radius: 10px;
}

/* Dark Mode */
.dark .map-legend {
  background: #1a1a1a;
  border-color: #333;
}

.dark .map-legend-item {
  color: #f3f4f6;
}

.dark .map-note {
  background: #78350f;
  color: #fef3c7;
}

/* GPS Mode Toggle Button */
.gps-mode-toggle {
  padding: 8px 14px;
  border-radius: 30px;
  font-weight: 800;
  font-size: 12px;
  cursor: pointer;
  border: 2px solid #13a89e;
  background: #ffffff;
  color: #13a89e;
  transition: all 0.3s;
}

.gps-mode-toggle.real {
  background: #13a89e;
  color: #ffffff;
  border-color: #13a89e;
}

.gps-mode-toggle:hover {
  transform: scale(1.05);
}

/* GPS Error Banner */
.gps-error-banner {
  max-width: 1000px;
  margin: 15px auto 0;
  padding: 12px 18px;
  background: #fee2e2;
  color: #dc2626;
  border: 1px solid #fecaca;
  border-radius: 12px;
  font-weight: 700;
  font-size: 13px;
  text-align: center;
}

@media (max-width: 600px) {
  .map-legend {
    flex-direction: column;
    align-items: flex-start;
  }
}/* ============================================================
   ADMIN SIDEBAR — GLASSMORPHISM PREMIUM
   ============================================================ */

.admin-sidebar {
  position: fixed;
  top: 20px;
  left: 20px;
  bottom: 20px;
  width: 300px;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 24px;
  box-shadow: 
    0 20px 60px rgba(31, 38, 135, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  padding: 20px 14px;
  display: flex;
  flex-direction: column;
  z-index: 1000;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
}

.dark .admin-sidebar {
  background: rgba(20, 25, 40, 0.65);
  border-color: rgba(255, 255, 255, 0.1);
  box-shadow: 
    0 20px 60px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

/* Top Ambient Light */
.admin-sidebar::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -20%;
  width: 140%;
  height: 200px;
  background: radial-gradient(ellipse, rgba(16, 185, 129, 0.15), transparent 70%);
  pointer-events: none;
}

/* Collapsed State */
.admin-sidebar.collapsed {
  width: 84px;
  padding: 20px 12px;
}

/* ========== HEADER ========== */
.admin-sidebar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 18px;
  margin-bottom: 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}

.dark .admin-sidebar-header {
  border-bottom-color: rgba(255, 255, 255, 0.08);
}

.admin-sidebar.collapsed .admin-sidebar-header {
  justify-content: center;
  padding-bottom: 15px;
}

.admin-sidebar-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  text-decoration: none;
  flex: 1;
  min-width: 0;
}

.admin-sidebar.collapsed .admin-sidebar-brand {
  justify-content: center;
  flex: 0;
}

.admin-sidebar-logo {
  width: 42px;
  height: 42px;
  min-width: 42px;
  border-radius: 13px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--green-500), var(--green-700));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35);
  flex-shrink: 0;
}

.admin-sidebar-logo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.admin-sidebar-brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
  min-width: 0;
}

.admin-sidebar-title {
  font-family: var(--font-heading);
  font-weight: 900;
  font-size: 16px;
  letter-spacing: -0.01em;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  white-space: nowrap;
}

.admin-sidebar-sub {
  font-size: 10px;
  color: var(--text-secondary);
  font-weight: 600;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

/* Toggle Button */
.admin-sidebar-toggle {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.25s ease;
  flex-shrink: 0;
}

.dark .admin-sidebar-toggle {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.1);
}

.admin-sidebar-toggle:hover {
  background: var(--primary);
  color: #FFFFFF;
  border-color: var(--primary);
  transform: scale(1.08);
}

.admin-sidebar-toggle.mobile {
  display: none;
}

/* ========== MENU ========== */
.admin-sidebar-menu {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 3px;
  overflow-y: auto;
  overflow-x: hidden;
  padding-right: 4px;
  margin-right: -4px;
  min-height: 0;
  position: relative;
  z-index: 2;
}

.admin-sidebar-menu::-webkit-scrollbar {
  width: 3px;
}

.admin-sidebar-menu::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.1);
  border-radius: 3px;
}

.dark .admin-sidebar-menu::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
}

/* Menu Link */
.admin-sidebar-link {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 11px 13px;
  border-radius: 13px;
  font-family: var(--font-heading);
  font-size: 13.5px;
  font-weight: 600;
  color: var(--text-secondary);
  text-decoration: none;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  border: none;
  background: transparent;
  cursor: pointer;
  width: 100%;
  letter-spacing: -0.005em;
  flex-shrink: 0;
}

.admin-sidebar-link svg {
  flex-shrink: 0;
  transition: transform 0.25s ease, color 0.25s ease;
}

.admin-sidebar-link span {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Hover */
.admin-sidebar-link:hover {
  background: rgba(255, 255, 255, 0.5);
  color: var(--text-primary);
  transform: translateX(3px);
}

.dark .admin-sidebar-link:hover {
  background: rgba(255, 255, 255, 0.05);
}

.admin-sidebar-link:hover svg {
  transform: scale(1.1);
  color: var(--primary);
}

/* Active */
.admin-sidebar-link.active {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(249, 115, 22, 0.08));
  color: var(--primary);
  font-weight: 700;
  box-shadow: 
    0 4px 12px rgba(16, 185, 129, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.dark .admin-sidebar-link.active {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(249, 115, 22, 0.1));
  color: var(--green-300);
}

/* Left Accent Bar for Active */
.admin-sidebar-link.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 4px;
  background: linear-gradient(180deg, var(--primary), var(--accent));
  border-radius: 0 4px 4px 0;
}

.admin-sidebar-link.active svg {
  color: var(--primary);
}

.dark .admin-sidebar-link.active svg {
  color: var(--green-300);
}

/* Collapsed Link Style */
.admin-sidebar.collapsed .admin-sidebar-link {
  justify-content: center;
  padding: 13px 0;
}

.admin-sidebar.collapsed .admin-sidebar-link:hover {
  transform: scale(1.05);
}

/* ========== FOOTER ========== */
.admin-sidebar-footer {
  padding-top: 14px;
  margin-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}

.dark .admin-sidebar-footer {
  border-top-color: rgba(255, 255, 255, 0.08);
}

.admin-sidebar-link.logout {
  color: #DC2626;
}

.admin-sidebar-link.logout:hover {
  background: rgba(220, 38, 38, 0.1);
  color: #DC2626;
}

.admin-sidebar-link.logout:hover svg {
  color: #DC2626;
}

/* ========== MOBILE ========== */
.admin-sidebar-mobile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 999;
  animation: fadeIn 0.25s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Main Content Area */
.admin-main {
  margin-left: 340px;
  padding: 20px 20px 20px 0;
  min-height: 100vh;
  transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.admin-main.sidebar-collapsed {
  margin-left: 120px;
}

/* Mobile Responsive */
@media (max-width: 900px) {
  .admin-sidebar {
    transform: translateX(-120%);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .admin-sidebar.mobile-open {
    transform: translateX(0);
  }

  .admin-sidebar-toggle.desktop {
    display: none;
  }

  .admin-sidebar-toggle.mobile {
    display: flex;
  }

  .admin-sidebar.collapsed {
    width: 300px;
    padding: 20px 14px;
  }

  .admin-sidebar.collapsed .admin-sidebar-brand-text,
  .admin-sidebar.collapsed .admin-sidebar-link span {
    display: block;
  }

  .admin-main {
    margin-left: 0 !important;
    padding: 80px 16px 20px;
  }
}/* ============================================================
   ADMIN PANEL — MAIN LAYOUT
   ============================================================ */

.admin-layout {
  min-height: 100vh;
  background: var(--bg-base);
  position: relative;
}

.admin-main-content {
  margin-left: 340px;
  padding: 24px 28px 40px;
  min-height: 100vh;
  transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.admin-sidebar.collapsed ~ .admin-main-content {
  margin-left: 124px;
}

/* ========== TOP BAR ========== */
.admin-topbar {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 14px 20px;
  background: var(--glass-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-glass);
  margin-bottom: 24px;
  position: sticky;
  top: 20px;
  z-index: 100;
}

.dark .admin-topbar {
  background: rgba(20, 25, 40, 0.65);
}

.admin-topbar-menu-btn {
  display: none;
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: var(--surface);
  border: 1px solid var(--border);
  color: var(--text-primary);
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.admin-topbar-menu-btn:hover {
  background: var(--primary);
  color: #FFFFFF;
  border-color: var(--primary);
}

.admin-topbar-search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 18px;
  border-radius: var(--radius-full);
  background: var(--glass-bg-light);
  border: 1px solid var(--border);
  color: var(--text-tertiary);
  transition: all var(--transition-base);
  max-width: 500px;
}

.admin-topbar-search:focus-within {
  border-color: var(--primary);
  background: var(--surface);
  box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);
}

.admin-topbar-search input {
  flex: 1;
  border: none;
  background: transparent;
  outline: none;
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
  min-width: 0;
}

.admin-topbar-search input::placeholder {
  color: var(--text-tertiary);
}

.admin-topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-left: auto;
}

.admin-topbar-icon-btn {
  position: relative;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--glass-bg-light);
  border: 1px solid var(--border);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.admin-topbar-icon-btn:hover {
  background: var(--primary);
  color: #FFFFFF;
  border-color: var(--primary);
  transform: translateY(-2px);
}

.admin-topbar-badge {
  position: absolute;
  top: -2px;
  right: -2px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: var(--radius-full);
  background: var(--error);
  color: #FFFFFF;
  font-size: 10px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid var(--surface);
}

.admin-topbar-profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 14px 6px 6px;
  border-radius: var(--radius-full);
  background: var(--glass-bg-light);
  border: 1px solid var(--border);
}

.admin-topbar-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #FFFFFF;
}

.admin-topbar-profile-info {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.admin-topbar-profile-info strong {
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 800;
  color: var(--text-primary);
}

.admin-topbar-profile-info small {
  font-size: 11px;
  color: var(--text-tertiary);
  font-weight: 600;
}

/* ========== PAGE HEADER ========== */
.admin-page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}

.admin-page-label {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  color: var(--primary);
  text-transform: uppercase;
  margin-bottom: 8px;
}

.admin-page-title {
  font-family: var(--font-heading);
  font-size: 30px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  margin-bottom: 6px;
}

.admin-page-sub {
  font-size: 15px;
  color: var(--text-secondary);
  font-weight: 500;
}

.admin-page-action {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 22px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #FFFFFF;
  font-size: 13.5px;
  font-weight: 700;
  border: none;
  cursor: pointer;
  transition: all var(--transition-base);
  box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
}

.admin-page-action:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(16, 185, 129, 0.45);
}

/* ========== STATS GRID ========== */
.admin-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 18px;
}

.glass-stat {
  position: relative;
  background: var(--glass-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  padding: 22px;
  display: flex;
  align-items: flex-start;
  gap: 16px;
  transition: all var(--transition-base);
  overflow: hidden;
}

.glass-stat::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 100px;
  height: 100px;
  border-radius: 50%;
  filter: blur(40px);
  opacity: 0.4;
  pointer-events: none;
}

.glass-stat.green::before { background: #10B981; }
.glass-stat.blue::before { background: #3B82F6; }
.glass-stat.orange::before { background: #F97316; }
.glass-stat.pink::before { background: #EC4899; }

.glass-stat:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-glass-hover);
}

.admin-stat-icon {
  width: 52px;
  height: 52px;
  min-width: 52px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  flex-shrink: 0;
}

.glass-stat.green .admin-stat-icon {
  background: linear-gradient(135deg, #10B981, #059669);
  box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
}

.glass-stat.blue .admin-stat-icon {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  box-shadow: 0 6px 20px rgba(59, 130, 246, 0.35);
}

.glass-stat.orange .admin-stat-icon {
  background: linear-gradient(135deg, #F97316, #EA580C);
  box-shadow: 0 6px 20px rgba(249, 115, 22, 0.35);
}

.glass-stat.pink .admin-stat-icon {
  background: linear-gradient(135deg, #EC4899, #DB2777);
  box-shadow: 0 6px 20px rgba(236, 72, 153, 0.35);
}

.admin-stat-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-stat-label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 0.2px;
}

.admin-stat-value {
  font-family: var(--font-heading);
  font-size: 26px;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.admin-stat-trend {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  font-size: 11.5px;
  font-weight: 700;
  color: var(--text-tertiary);
  margin-top: 4px;
}

.admin-stat-trend.up {
  color: #10B981;
}

.admin-stat-trend.down {
  color: #EF4444;
}

/* ========== MINI STATS ========== */
.admin-stats-grid-small {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.admin-stat-mini {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
  background: var(--glass-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  transition: all var(--transition-base);
}

.admin-stat-mini:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
}

.admin-stat-mini svg {
  color: var(--primary);
  flex-shrink: 0;
}

.admin-stat-mini div {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
  min-width: 0;
}

.admin-stat-mini strong {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.admin-stat-mini span {
  font-size: 11.5px;
  color: var(--text-tertiary);
  font-weight: 600;
}

/* ========== CHARTS GRID ========== */
.admin-charts-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 18px;
  margin-bottom: 24px;
}

.admin-chart-card {
  background: var(--glass-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  padding: 22px;
  color: var(--text-secondary);
}

.admin-chart-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18px;
  gap: 12px;
}

.admin-chart-header h3 {
  font-family: var(--font-heading);
  font-size: 17px;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 4px;
  letter-spacing: -0.01em;
}

.admin-chart-header p {
  font-size: 12.5px;
  color: var(--text-tertiary);
  font-weight: 500;
}

.admin-chart-badge {
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, var(--green-50), var(--orange-50));
  color: var(--primary);
  font-family: var(--font-heading);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: -0.01em;
}

.dark .admin-chart-badge {
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.15), rgba(249, 115, 22, 0.15));
  color: var(--green-300);
}

/* ========== SECTION ========== */
.admin-section {
  background: var(--glass-bg);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-xl);
  padding: 22px;
  margin-bottom: 24px;
}

.admin-section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18px;
}

.admin-section-header h2 {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 4px;
  letter-spacing: -0.01em;
}

.admin-section-header p {
  font-size: 13px;
  color: var(--text-tertiary);
  font-weight: 500;
}

/* ========== TOP LIST ========== */
.admin-top-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.admin-top-item {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px 16px;
  border-radius: var(--radius-lg);
  background: var(--glass-bg-light);
  border: 1px solid transparent;
  transition: all var(--transition-fast);
}

.admin-top-item:hover {
  background: var(--glass-bg);
  border-color: var(--glass-border);
  transform: translateX(4px);
}

.admin-top-rank {
  font-family: var(--font-heading);
  font-size: 15px;
  font-weight: 900;
  color: var(--primary);
  min-width: 32px;
}

.admin-top-logo {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--green-100), var(--green-200));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  flex-shrink: 0;
}

.dark .admin-top-logo {
  background: rgba(16, 185, 129, 0.15);
}

.admin-top-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.admin-top-info strong {
  font-family: var(--font-heading);
  font-size: 14.5px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.005em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.admin-top-info span {
  font-size: 12px;
  color: var(--text-tertiary);
  font-weight: 500;
}

.admin-top-stats {
  display: flex;
  gap: 20px;
  flex-shrink: 0;
}

.admin-top-stat {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  line-height: 1.2;
}

.admin-top-stat strong {
  font-family: var(--font-heading);
  font-size: 14px;
  font-weight: 800;
  color: var(--text-primary);
}

.admin-top-stat span {
  font-size: 11px;
  color: var(--text-tertiary);
  font-weight: 600;
}

/* ========== RESPONSIVE ========== */
@media (max-width: 1200px) {
  .admin-stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .admin-stats-grid-small {
    grid-template-columns: repeat(2, 1fr);
  }
  .admin-charts-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 900px) {
  .admin-main-content {
    margin-left: 0;
    padding: 80px 16px 30px;
  }

  .admin-topbar-menu-btn {
    display: flex;
  }

  .admin-topbar {
    padding: 12px;
    border-radius: var(--radius-lg);
  }

  .admin-topbar-search {
    display: none;
  }

  .admin-topbar-profile-info {
    display: none;
  }

  .admin-page-title {
    font-size: 24px;
  }
}

@media (max-width: 600px) {
  .admin-stats-grid {
    grid-template-columns: 1fr;
  }

  .admin-stats-grid-small {
    grid-template-columns: 1fr;
  }

  .admin-stat-value {
    font-size: 22px;
  }

  .admin-top-stats {
    gap: 12px;
  }

  .admin-top-item {
    padding: 12px;
    gap: 10px;
  }
}/* ============================================================
   ADMIN SIDEBAR — LOGO SIZE FIX (GLOBAL IMG OVERRIDE FIX)
   ============================================================ */

/* Sidebar Logo — Fixed Size (Global IMG override করে) */
.admin-sidebar .admin-sidebar-logo,
.admin-sidebar .admin-sidebar-logo img {
  width: 42px !important;
  height: 42px !important;
  max-width: 42px !important;
  max-height: 42px !important;
  object-fit: cover !important;
  display: block !important;
  border-radius: 13px !important;
}

/* Navbar Logo — Fixed Size */
.glass-navbar .glass-logo-icon,
.glass-navbar .glass-logo-icon img {
  width: 42px !important;
  height: 42px !important;
  max-width: 42px !important;
  max-height: 42px !important;
  object-fit: cover !important;
  display: block !important;
}

/* Mobile Menu Logo — Fixed Size */
.glass-mobile-menu .glass-mobile-logo {
  width: 38px !important;
  height: 38px !important;
  max-width: 38px !important;
  max-height: 38px !important;
  object-fit: cover !important;
}

/* Fallback — সব Logo Image Fixed Size */
img[alt="AraiFood"] {
  max-width: 60px !important;
  max-height: 60px !important;
}

/* ========== ADMIN MAIN CONTENT PADDING FIX ========== */
.admin-layout {
  position: relative;
}

.admin-main-content {
  margin-left: 340px;
  padding: 24px 28px 40px;
  min-height: 100vh;
  transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.admin-sidebar.collapsed ~ .admin-main-content {
  margin-left: 124px;
}

@media (max-width: 900px) {
  .admin-main-content {
    margin-left: 0;
    padding: 20px 16px 30px;
  }
}