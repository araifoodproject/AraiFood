/* =========================================
   ARAIFOOD - GLOBAL STYLES
========================================= */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --primary: #13a89e;
  --primary-dark: #0e7f78;
  --primary-light: #e6f7f6;
  --text: #4a5568;
  --text-dark: #1a202c;
  --bg: #f8fafc;
  --white: #ffffff;
  --border: #e2e8f0;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.12);
  --radius: 12px;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: var(--bg);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s ease;
}

input, textarea, select {
  font-family: inherit;
}

/* =========================================
   NAVBAR
========================================= */
.arai-navbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.arai-navbar-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 15px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.arai-logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

.arai-logo-icon {
  width: 40px;
  height: 40px;
  background: var(--primary-light);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}

.arai-logo-text {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.arai-logo-text span {
  font-weight: 800;
  font-size: 18px;
  color: var(--text-dark);
  letter-spacing: 0.5px;
}

.arai-logo-text small {
  font-size: 12px;
  color: var(--primary);
  font-weight: 600;
}

.arai-nav-links {
  display: flex;
  gap: 24px;
  align-items: center;
}

.arai-nav-links a {
  font-weight: 600;
  color: var(--text);
  font-size: 15px;
  transition: color 0.2s;
}

.arai-nav-links a:hover, .arai-nav-links a.active {
  color: var(--primary);
}

.arai-nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.arai-nav-icon {
  background: transparent;
  border: none;
  font-size: 20px;
  color: var(--text-dark);
}

.arai-cart-button {
  background: var(--primary-light);
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  font-size: 18px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arai-cart-badge {
  position: absolute;
  top: -2px;
  right: -2px;
  background: var(--primary);
  color: var(--white);
  font-size: 10px;
  font-weight: 700;
  border-radius: 50%;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arai-account-button {
  background: var(--text-dark);
  color: var(--white);
  border: none;
  padding: 8px 16px;
  border-radius: 30px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
  font-size: 14px;
}

.arai-menu-button {
  display: none;
  background: transparent;
  border: none;
  font-size: 24px;
  color: var(--text-dark);
}

.arai-mobile-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--white);
  border-bottom: 1px solid var(--border);
  padding: 10px 20px;
  flex-direction: column;
}

.arai-mobile-menu a {
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
  font-weight: 500;
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .arai-nav-links {
    display: none;
  }
  .arai-account-text {
    display: none;
  }
  .arai-account-button {
    padding: 8px 10px;
  }
  .arai-menu-button {
    display: block;
  }
  .arai-mobile-menu {
    display: flex;
  }
}

/* =========================================
   HERO SECTION
========================================= */
.arai-hero {
  position: relative;
  background: linear-gradient(135deg, #e6f7f6 0%, #f8fafc 100%);
  padding: 60px 20px 80px;
  overflow: hidden;
}

.arai-hero-container {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
  position: relative;
  z-index: 2;
}

.arai-hero-bg-shape {
  position: absolute;
  border-radius: 50%;
  filter: blur(40px);
  opacity: 0.3;
}

.shape-one {
  width: 300px;
  height: 300px;
  background: var(--primary);
  top: 10%;
  left: -50px;
}

.shape-two {
  width: 200px;
  height: 200px;
  background: #ffb86b;
  bottom: 0;
  right: 0;
}

.arai-hero-badge {
  display: inline-block;
  background: var(--white);
  padding: 8px 16px;
  border-radius: 30px;
  font-weight: 600;
  color: var(--text-dark);
  box-shadow: var(--shadow);
  margin-bottom: 20px;
  font-size: 14px;
}

.arai-hero-content h1 {
  font-size: 48px;
  line-height: 1.2;
  font-weight: 800;
  color: var(--text-dark);
  margin-bottom: 20px;
}

.arai-hero-content h1 span {
  color: var(--primary);
}

.arai-hero-description {
  font-size: 18px;
  line-height: 1.6;
  margin-bottom: 30px;
  color: var(--text);
  max-width: 500px;
}

.arai-hero-search {
  display: flex;
  align-items: center;
  background: var(--white);
  padding: 8px;
  border-radius: 50px;
  box-shadow: var(--shadow-lg);
  margin-bottom: 40px;
  max-width: 500px;
}

.arai-search-icon {
  padding: 0 10px;
  font-size: 20px;
}

.arai-hero-search input {
  flex: 1;
  border: none;
  outline: none;
  padding: 10px;
  font-size: 16px;
  background: transparent;
}

.arai-hero-search button {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 12px 24px;
  border-radius: 40px;
  font-weight: 700;
  font-size: 15px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.arai-hero-features {
  display: flex;
  align-items: center;
  gap: 20px;
}

.arai-hero-feature {
  display: flex;
  align-items: center;
  gap: 10px;
}

.arai-hero-feature div:first-child {
  font-size: 24px;
}

.arai-hero-feature span {
  display: flex;
  flex-direction: column;
}

.arai-hero-feature strong {
  font-size: 14px;
  color: var(--text-dark);
}

.arai-hero-feature small {
  font-size: 12px;
  color: var(--text);
}

.arai-feature-divider {
  width: 1px;
  height: 30px;
  background: var(--border);
}

/* Hero Right Visual */
.arai-hero-visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.arai-food-glow {
  position: absolute;
  width: 250px;
  height: 250px;
  background: rgba(19, 168, 158, 0.2);
  border-radius: 50%;
  filter: blur(50px);
}

.arai-main-food-card {
  background: var(--white);
  border-radius: 20px;
  padding: 20px;
  box-shadow: var(--shadow-lg);
  width: 220px;
  position: relative;
  z-index: 10;
  text-align: center;
}

.arai-food-image {
  font-size: 60px;
  margin-bottom: 10px;
}

.arai-food-card-info {
  text-align: left;
}

.arai-food-category {
  display: block;
  font-size: 10px;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 5px;
  letter-spacing: 0.5px;
}

.arai-food-card-info h3 {
  font-size: 16px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.arai-food-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.arai-food-price {
  font-size: 18px;
  font-weight: 800;
  color: var(--text-dark);
}

.arai-food-rating {
  font-size: 14px;
  color: #f59e0b;
  font-weight: 600;
}

.arai-floating-card {
  position: absolute;
  background: var(--white);
  padding: 12px 16px;
  border-radius: 12px;
  box-shadow: var(--shadow-lg);
  display: flex;
  align-items: center;
  gap: 10px;
  z-index: 20;
}

.delivery-card {
  top: 20px;
  right: 10px;
  animation: float 3s ease-in-out infinite;
}

.rating-card {
  bottom: 20px;
  left: 10px;
  flex-direction: column;
  text-align: center;
  animation: float 4s ease-in-out infinite;
}

.floating-icon {
  font-size: 24px;
}

.arai-floating-card strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
}

.arai-floating-card small {
  font-size: 12px;
  color: var(--text);
}

.rating-stars {
  color: #f59e0b;
  font-size: 14px;
}

.arai-food-bubble {
  position: absolute;
  width: 50px;
  height: 50px;
  background: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  box-shadow: var(--shadow);
  animation: float 5s ease-in-out infinite;
}

.bubble-one { top: 10%; right: 0; }
.bubble-two { bottom: 10%; right: 20%; animation-delay: 1s; }
.bubble-three { top: 40%; left: 0; animation-delay: 2s; }

.arai-hero-wave {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 50px;
  background: var(--bg);
  clip-path: ellipse(80% 50% at 50% 100%);
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

/* Mobile Responsive for Hero */
@media (max-width: 768px) {
  .arai-hero-container {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .arai-hero-content h1 {
    font-size: 32px;
  }
  .arai-hero-description {
    margin: 0 auto 20px;
  }
  .arai-hero-search {
    margin: 0 auto 20px;
  }
  .arai-hero-features {
    justify-content: center;
  }
  .arai-hero-visual {
    display: none;
  }
}

/* =========================================
   CATEGORIES SECTION
========================================= */
.categories {
  max-width: 1200px;
  margin: 60px auto;
  padding: 0 20px;
}

.categories-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 30px;
}

.section-label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: var(--primary);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 8px;
}

.categories-header h2 {
  font-size: 32px;
  color: var(--text-dark);
  margin-bottom: 8px;
}

.categories-header p {
  color: var(--text);
}

.view-all {
  background: transparent;
  border: 1px solid var(--primary);
  color: var(--primary);
  padding: 10px 20px;
  border-radius: 30px;
  font-weight: 600;
}

.view-all:hover {
  background: var(--primary);
  color: var(--white);
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  gap: 20px;
}

.category-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s;
}

.category-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
  border-color: var(--primary);
}

.category-icon {
  font-size: 40px;
  margin-bottom: 12px;
}

.category-card h3 {
  color: var(--text-dark);
  font-size: 16px;
  margin-bottom: 5px;
}

.category-card p {
  font-size: 12px;
  color: var(--text);
}

/* =========================================
   RESTAURANT GRID (Home Page)
========================================= */
.restaurants {
  max-width: 1200px;
  margin: 60px auto;
  padding: 0 20px;
}

.restaurants-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 30px;
}

.restaurants-header h2 {
  font-size: 32px;
  color: var(--text-dark);
}

.restaurant-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 24px;
}

.restaurant-card {
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--border);
  cursor: pointer;
  transition: all 0.3s;
}

.restaurant-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
}

.restaurant-image {
  position: relative;
  background: var(--primary-light);
  height: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60px;
}

.restaurant-rating {
  position: absolute;
  top: 10px;
  right: 10px;
  background: var(--white);
  padding: 4px 8px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
  color: var(--text-dark);
  box-shadow: var(--shadow);
}

.restaurant-info {
  padding: 15px;
}

.restaurant-info h3 {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.restaurant-info p {
  font-size: 13px;
  color: var(--text);
  margin-bottom: 10px;
}

.restaurant-meta {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-dark);
}

/* =========================================
   OFFERS SECTION
========================================= */
.offers {
  background: linear-gradient(135deg, #13a89e 0%, #0e7f78 100%);
  border-radius: 20px;
  max-width: 1200px;
  margin: 60px auto;
  padding: 0 20px;
}

.offers-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40px;
  color: var(--white);
}

.offers-text {
  max-width: 500px;
}

.offer-label {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 15px;
}

.offers-text h2 {
  font-size: 32px;
  margin-bottom: 15px;
}

.offers-text p {
  margin-bottom: 20px;
  opacity: 0.9;
}

.offer-button {
  background: var(--white);
  color: var(--primary);
  border: none;
  padding: 12px 24px;
  border-radius: 30px;
  font-weight: 700;
}

.offer-visual {
  position: relative;
}

.offer-circle {
  width: 120px;
  height: 120px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 800;
}

.offer-emoji {
  position: absolute;
  font-size: 30px;
}

.emoji-one { top: -20px; left: -20px; }
.emoji-two { top: 20px; right: -30px; }
.emoji-three { bottom: -20px; left: 20px; }

/* =========================================
   FOOTER
========================================= */
.footer {
  background: var(--text-dark);
  color: var(--white);
  padding: 60px 20px 20px;
  margin-top: auto;
}

.footer-content {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-brand h2 {
  font-size: 28px;
  margin-bottom: 15px;
}

.footer-brand p {
  opacity: 0.8;
  line-height: 1.6;
  max-width: 300px;
}

.footer-column h3 {
  font-size: 16px;
  margin-bottom: 15px;
}

.footer-column a {
  display: block;
  margin-bottom: 10px;
  opacity: 0.8;
  transition: opacity 0.2s;
}

.footer-column a:hover {
  opacity: 1;
  color: var(--primary);
}

.footer-bottom {
  max-width: 1200px;
  margin: 20px auto 0;
  text-align: center;
  opacity: 0.6;
  font-size: 14px;
}

@media (max-width: 768px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: 20px;
  }
}

/* =========================================
   RESTAURANTS PAGE (Search/Filter)
========================================= */
.restaurants-page {
  min-height: 100vh;
  background: var(--bg);
}

.restaurants-page-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 20px;
}

.restaurants-page-header {
  text-align: center;
  margin-bottom: 40px;
}

.restaurants-page-header h1 {
  font-size: 40px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.restaurants-page-header h1 span {
  color: var(--primary);
}

.restaurants-page-header p {
  color: var(--text);
  max-width: 600px;
  margin: 0 auto;
}

.restaurant-page-stats {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.restaurant-stat {
  background: var(--white);
  padding: 15px 25px;
  border-radius: var(--radius);
  text-align: center;
  box-shadow: var(--shadow);
}

.restaurant-stat strong {
  display: block;
  color: var(--primary);
  font-size: 24px;
  margin-bottom: 5px;
}

.restaurant-stat span {
  font-size: 13px;
}

.restaurant-controls {
  background: var(--white);
  padding: 20px;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  margin-bottom: 30px;
}

.restaurant-search {
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 0 10px;
  margin-bottom: 15px;
}

.restaurant-search span {
  font-size: 18px;
}

.restaurant-search input {
  flex: 1;
  border: none;
  outline: none;
  padding: 12px;
  font-size: 15px;
}

.clear-search {
  background: transparent;
  border: none;
  font-size: 20px;
  color: var(--text);
}

.restaurant-filter-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 15px;
}

.restaurant-filter {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 8px 16px;
  border-radius: 30px;
  font-size: 14px;
  font-weight: 600;
}

.restaurant-filter.active {
  background: var(--primary);
  color: var(--white);
  border-color: var(--primary);
}

.restaurant-sort {
  display: flex;
  align-items: center;
  gap: 10px;
}

.restaurant-sort label {
  font-size: 14px;
  font-weight: 600;
}

.restaurant-sort select {
  padding: 10px;
  border-radius: 8px;
  border: 1px solid var(--border);
  font-size: 14px;
  background: var(--bg);
}

.restaurants-list-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 20px;
}

.restaurants-list-header h2 {
  font-size: 28px;
  color: var(--text-dark);
}

.restaurant-count {
  color: var(--text);
  font-weight: 600;
}

.all-restaurants-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 24px;
  margin-bottom: 40px;
}

.all-restaurant-card {
  background: var(--white);
  border-radius: var(--radius);
  overflow: hidden;
  border: 1px solid var(--border);
  transition: all 0.3s;
}

.all-restaurant-card:hover {
  box-shadow: var(--shadow-lg);
  transform: translateY(-3px);
}

.all-restaurant-image {
  position: relative;
  background: var(--primary-light);
  height: 150px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.restaurant-main-emoji {
  font-size: 70px;
}

.restaurant-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: #f59e0b;
  color: var(--white);
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
}

.all-restaurant-rating {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background: var(--white);
  padding: 4px 8px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
  box-shadow: var(--shadow);
}

.all-restaurant-info {
  padding: 15px;
}

.restaurant-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.restaurant-title-row h2 {
  font-size: 18px;
  color: var(--text-dark);
}

.restaurant-price {
  background: var(--primary-light);
  color: var(--primary);
  padding: 4px 8px;
  border-radius: 6px;
  font-weight: 700;
  font-size: 14px;
}

.restaurant-cuisine {
  color: var(--text);
  font-size: 14px;
  margin-bottom: 12px;
}

.all-restaurant-meta {
  display: flex;
  gap: 15px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 15px;
}

.restaurant-menu-button {
  width: 100%;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 600;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.restaurant-empty-state {
  text-align: center;
  padding: 60px 20px;
  background: var(--white);
  border-radius: var(--radius);
}

.empty-icon {
  font-size: 60px;
  margin-bottom: 20px;
}

.restaurant-empty-state h2 {
  color: var(--text-dark);
  margin-bottom: 10px;
}

.restaurant-empty-state p {
  margin-bottom: 20px;
}

.restaurant-empty-state button {
  background: var(--primary);
  color: var(--white);
  padding: 10px 20px;
  border: none;
  border-radius: 8px;
  font-weight: 600;
}

.restaurants-bottom-cta {
  background: var(--primary-light);
  border-radius: var(--radius);
  padding: 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.restaurants-bottom-cta h2 {
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 8px;
}

.restaurants-bottom-cta p {
  margin-bottom: 0;
}

.restaurants-bottom-cta button {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 12px 24px;
  border-radius: 30px;
  font-weight: 700;
}

@media (max-width: 768px) {
  .restaurants-page-header h1 {
    font-size: 28px;
  }
  .restaurant-controls {
    padding: 15px;
  }
  .restaurants-bottom-cta {
    flex-direction: column;
    text-align: center;
    gap: 20px;
  }
}/* =========================================
   RESTAURANT PAGE (Single Restaurant Menu)
========================================= */
.restaurant-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 40px 20px;
}

.restaurant-page-header {
  max-width: 800px;
  margin: 0 auto 30px;
  background: var(--white);
  padding: 20px;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  display: flex;
  align-items: center;
  gap: 20px;
}

.restaurant-page-header button {
  background: var(--bg);
  border: 1px solid var(--border);
  padding: 10px 15px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
}

.restaurant-page-header h1 {
  font-size: 28px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.restaurant-page-header p {
  color: var(--text);
  font-size: 14px;
  margin-bottom: 5px;
}

.restaurant-page-header span {
  font-size: 14px;
  font-weight: 600;
}

.menu-section {
  max-width: 800px;
  margin: 0 auto;
}

.menu-heading {
  margin-bottom: 30px;
}

.menu-heading h2 {
  font-size: 28px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.food-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
}

.food-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 15px;
  display: flex;
  gap: 15px;
  align-items: center;
  transition: all 0.3s;
}

.food-card:hover {
  box-shadow: var(--shadow);
  border-color: var(--primary);
}

.food-image {
  font-size: 40px;
  background: var(--primary-light);
  padding: 15px;
  border-radius: 12px;
}

.food-info {
  flex: 1;
}

.food-info h3 {
  font-size: 16px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.food-info p {
  font-size: 13px;
  color: var(--text);
  margin-bottom: 10px;
}

.food-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.food-bottom strong {
  font-size: 18px;
  color: var(--text-dark);
}

.food-bottom button {
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 8px 12px;
  border-radius: 8px;
  font-weight: 600;
}

.floating-cart-button {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 15px 20px;
  border-radius: 50px;
  font-size: 16px;
  font-weight: 700;
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

/* =========================================
   CART (Overlay / Sidebar)
========================================= */
.cart-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  justify-content: flex-end;
  animation: fadeIn 0.3s ease;
}

.cart-panel {
  width: 100%;
  max-width: 400px;
  background: var(--white);
  height: 100%;
  display: flex;
  flex-direction: column;
  box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
  animation: slideInRight 0.3s ease;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid var(--border);
}

.cart-header h2 {
  font-size: 24px;
  color: var(--text-dark);
}

.cart-close {
  background: var(--bg);
  border: none;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  font-size: 20px;
  cursor: pointer;
}

.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  text-align: center;
  padding: 20px;
}

.empty-cart div {
  font-size: 60px;
  margin-bottom: 20px;
}

.empty-cart h3 {
  font-size: 20px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.empty-cart p {
  color: var(--text);
}


.cart-quantity {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cart-quantity button {
  background: var(--bg);
  border: 1px solid var(--border);
  width: 25px;
  height: 25px;
  border-radius: 5px;
  font-weight: 700;
  cursor: pointer;
}

.cart-quantity span {
  font-weight: 700;
  color: var(--text-dark);
}

.cart-total {
  padding: 20px;
  border-top: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  font-size: 18px;
}

.cart-total strong {
  color: var(--text-dark);
}

.checkout-button {
  background: var(--primary);
  color: var(--white);
  border: none;
  margin: 0 20px 20px;
  padding: 15px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideInRight {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

/* =========================================
   CHECKOUT PAGE
========================================= */
.checkout-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 40px 20px;
}

.checkout-container {
  max-width: 1000px;
  margin: 0 auto;
}

.checkout-header {
  margin-bottom: 30px;
}

.checkout-back-button {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 10px 15px;
  border-radius: 8px;
  font-weight: 600;
  margin-bottom: 20px;
  cursor: pointer;
}

.checkout-title h1 {
  font-size: 32px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.checkout-title p {
  color: var(--text);
}

.checkout-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
}

.checkout-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow);
}

.checkout-card-heading {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
}

.checkout-icon {
  font-size: 24px;
  background: var(--primary-light);
  padding: 10px;
  border-radius: 10px;
}

.checkout-card-heading h2 {
  font-size: 20px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.checkout-card-heading p {
  font-size: 13px;
  color: var(--text);
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 8px;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 14px;
  outline: none;
  transition: border-color 0.3s;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: var(--primary);
}

.save-address-option {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 500;
}

.save-address-option input {
  accent-color: var(--primary);
  width: 18px;
  height: 18px;
}

.map-coming-soon {
  background: var(--primary-light);
  border-radius: 10px;
  padding: 20px;
  margin-bottom: 20px;
  display: flex;
  gap: 15px;
  align-items: flex-start;
}

.map-coming-icon {
  font-size: 30px;
}

.map-coming-soon h3 {
  font-size: 16px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.coming-soon-badge {
  background: #f59e0b;
  color: var(--white);
  font-size: 10px;
  padding: 3px 8px;
  border-radius: 20px;
  font-weight: 700;
}

.map-coming-soon p {
  font-size: 13px;
  color: var(--text);
}

.payment-section {
  margin-bottom: 20px;
}

.payment-heading {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 15px;
}

.payment-heading h2 {
  font-size: 18px;
  color: var(--text-dark);
}

.payment-heading p {
  font-size: 12px;
  color: var(--text);
}

.payment-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.payment-option {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border);
  padding: 15px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s;
}

.payment-option:hover {
  border-color: var(--primary);
  background: var(--primary-light);
}

.payment-option input {
  accent-color: var(--primary);
}

.payment-option strong {
  display: block;
  color: var(--text-dark);
  font-size: 14px;
  margin-bottom: 4px;
}

.payment-option small {
  color: var(--text);
  font-size: 12px;
}

.place-order-button {
  width: 100%;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 15px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}

.checkout-summary {
  height: fit-content;
}

.checkout-summary h2 {
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 20px;
}

.summary-restaurant {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  background: var(--bg);
  padding: 10px;
  border-radius: 8px;
}

.summary-restaurant > span {
  font-size: 30px;
}

.summary-restaurant strong {
  display: block;
  color: var(--text-dark);
  font-size: 14px;
}

.summary-restaurant small {
  color: var(--text);
  font-size: 12px;
}

.summary-items {
  margin-bottom: 20px;
  max-height: 200px;
  overflow-y: auto;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.summary-item span {
  font-size: 14px;
}

.summary-item small {
  display: block;
  font-size: 12px;
  color: var(--text);
}

.summary-item strong {
  color: var(--text-dark);
}

.summary-divider {
  border-top: 1px dashed var(--border);
  margin: 20px 0;
}

.summary-total {
  display: flex;
  justify-content: space-between;
  font-size: 18px;
  margin-top: 15px;
}

.summary-total strong {
  color: var(--primary);
  font-size: 20px;
}

.checkout-note {
  margin-top: 20px;
  font-size: 12px;
  color: var(--text);
  text-align: center;
}

@media (max-width: 768px) {
  .checkout-content {
    grid-template-columns: 1fr;
  }
}

/* =========================================
   LOGIN & SIGNUP PAGE
========================================= */
.login-page {
  min-height: 100vh;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.login-card {
  background: var(--white);
  border-radius: 20px;
  padding: 40px;
  box-shadow: var(--shadow-lg);
  width: 100%;
  max-width: 400px;
}

.login-header {
  text-align: center;
  margin-bottom: 30px;
}

.login-header h1 {
  font-size: 28px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.login-header p {
  color: var(--text);
  font-size: 14px;
}

.login-submit-button {
  width: 100%;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 15px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 700;
  margin-top: 10px;
  cursor: pointer;
}

.login-error {
  background: #fee2e2;
  color: #dc2626;
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
  margin-bottom: 15px;
}

.login-footer {
  margin-top: 20px;
  text-align: center;
  font-size: 14px;
}

.login-footer p {
  margin-bottom: 5px;
}

.signup-link {
  background: transparent;
  border: none;
  color: var(--primary);
  font-weight: 700;
  cursor: pointer;
}

/* =========================================
   ACCOUNT PAGE
========================================= */
.account-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 40px 20px;
}

.account-container {
  max-width: 600px;
  margin: 0 auto;
}

.account-header {
  margin-bottom: 30px;
}

.account-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.account-home-button {
  background: var(--white);
  border: 1px solid var(--border);
  padding: 8px 12px;
  border-radius: 8px;
  cursor: pointer;
}

.account-header-badge {
  background: var(--primary-light);
  color: var(--primary);
  font-size: 12px;
  font-weight: 700;
  padding: 6px 12px;
  border-radius: 20px;
}

.account-header h1 {
  font-size: 32px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.account-header h1 span {
  color: var(--primary);
}

.account-header p {
  color: var(--text);
}

.account-card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow);
}

.account-profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 20px;
}

.profile-avatar-wrapper {
  position: relative;
  margin-bottom: 15px;
}

.account-avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40px;
  overflow: hidden;
}

.account-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-online-dot {
  position: absolute;
  bottom: 5px;
  right: 5px;
  width: 15px;
  height: 15px;
  background: #22c55e;
  border: 2px solid var(--white);
  border-radius: 50%;
}

.profile-photo-button {
  background: var(--primary-light);
  color: var(--primary);
  padding: 8px 15px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  margin-bottom: 15px;
}

.profile-photo-button input {
  display: none;
}

.profile-main-info h2 {
  font-size: 20px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.profile-main-info p {
  font-size: 14px;
  color: var(--text);
  margin-bottom: 10px;
}

.profile-status {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 12px;
  font-weight: 600;
  color: #22c55e;
}

.profile-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
}

.account-divider {
  border-top: 1px solid var(--border);
  margin: 20px 0;
}

.account-section-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
}

.account-section-icon {
  background: var(--primary-light);
  padding: 8px;
  border-radius: 8px;
  font-size: 18px;
}

.account-section-title h3 {
  font-size: 18px;
  color: var(--text-dark);
  margin-bottom: 3px;
}

.account-section-title p {
  font-size: 13px;
  color: var(--text);
}

.account-form-group {
  margin-bottom: 20px;
}

.account-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.account-input-icon {
  position: absolute;
  left: 12px;
  color: var(--text);
  font-size: 16px;
}

.account-input-wrapper input {
  width: 100%;
  padding: 12px 12px 12px 40px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 14px;
  outline: none;
}

.account-input-wrapper input:focus {
  border-color: var(--primary);
}

.verify-phone-button {
  background: var(--primary-light);
  color: var(--primary);
  border: 1px solid var(--primary);
  padding: 10px;
  width: 100%;
  border-radius: 8px;
  font-weight: 700;
  margin-top: 10px;
  cursor: pointer;
}

.phone-verified-box {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #166534;
  padding: 12px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
  font-size: 14px;
}

.phone-verified-icon {
  background: #22c55e;
  color: var(--white);
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}

.otp-verification-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 20px;
  margin-bottom: 20px;
}

.otp-header {
  display: flex;
  gap: 10px;
  margin-bottom: 15px;
}

.otp-icon {
  font-size: 24px;
}

.otp-header h3 {
  font-size: 16px;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.otp-header p {
  font-size: 13px;
}

.otp-input-group label {
  display: block;
  font-size: 12px;
  font-weight: 600;
  margin-bottom: 6px;
}

.otp-input-group input {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 20px;
  letter-spacing: 8px;
  text-align: center;
  outline: none;
}

.otp-verify-button {
  width: 100%;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 12px;
  border-radius: 8px;
  font-weight: 700;
  margin-top: 15px;
  cursor: pointer;
}

.otp-security-note {
  font-size: 12px;
  color: var(--text);
  text-align: center;
  margin-top: 10px;
}

.recaptcha-container {
  margin: 20px 0;
  display: flex;
  justify-content: center;
}

.account-textarea-wrapper {
  position: relative;
}

.account-textarea-icon {
  position: absolute;
  left: 12px;
  top: 12px;
}

.account-textarea-wrapper textarea {
  width: 100%;
  padding: 12px 12px 12px 40px;
  border: 1px solid var(--border);
  border-radius: 8px;
  font-size: 14px;
  outline: none;
  resize: vertical;
}

.account-textarea-wrapper textarea:focus {
  border-color: var(--primary);
}

.address-helper {
  font-size: 12px;
  color: var(--text);
  margin-top: 8px;
}

.account-save-button {
  width: 100%;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 15px;
  border-radius: 10px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
}

.account-message {
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  text-align: center;
  margin-top: 15px;
}

.account-message.success {
  background: #f0fdf4;
  color: #166534;
}

.account-message.error {
  background: #fee2e2;
  color: #dc2626;
}

.account-information-card {
  background: var(--bg);
  border-radius: 10px;
  padding: 20px;
  margin-bottom: 20px;
}

.account-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.account-info-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.account-info-icon {
  font-size: 20px;
}

.account-info-content span {
  display: block;
  font-size: 12px;
  color: var(--text);
}

.account-info-content strong {
  font-size: 14px;
  color: var(--text-dark);
}

.verified-text {
  color: #22c55e;
}

.unverified-text {
  color: #dc2626;
}

.account-actions {
  display: flex;
  gap: 10px;
}

.account-logout-button,
.account-home-button-large {
  flex: 1;
  padding: 12px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.account-logout-button {
  background: #fee2e2;
  color: #dc2626;
  border: none;
}

.account-home-button-large {
  background: var(--white);
  border: 1px solid var(--border);
  color: var(--text-dark);
}

/* =========================================
   ABOUT & OFFERS PAGE
========================================= */
.account-card {
  border: 1px solid var(--border);
  background: var(--white);
  border-radius: var(--radius);
  padding: 30px;
}

.account-card h2 {
  font-size: 24px;
  color: var(--text-dark);
  margin-bottom: 15px;
}

.account-card h3 {
  font-size: 18px;
  color: var(--text-dark);
  margin-bottom: 15px;
}

.account-card p {
  margin-bottom: 12px;
  line-height: 1.6;
}/* =========================================
   CART PAGE
========================================= */
.cart-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 40px 20px;
}

.cart-page-container {
  max-width: 800px;
  margin: 0 auto;
}

.cart-page-header {
  text-align: center;
  margin-bottom: 30px;
}

.cart-page-header h1 {
  font-size: 36px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.cart-page-content {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.cart-items-list {
  background: var(--white);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow);
}

.cart-summary {
  background: var(--white);
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow);
}

.remove-item {
  background: #fee2e2;
  color: #dc2626;
  border: none;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  font-size: 18px;
  cursor: pointer;
}/* =========================================
   CHECKOUT PAYMENT & SUCCESS PAGE CSS
========================================= */
.payment-option.selected {
  border-color: var(--primary);
  background: var(--primary-light);
}

.order-success-container {
  max-width: 500px;
  margin: 100px auto;
  text-align: center;
  background: var(--white);
  padding: 40px;
  border-radius: 20px;
  box-shadow: var(--shadow-lg);
}

.order-success-icon {
  font-size: 80px;
  margin-bottom: 20px;
}

.order-success-container h1 {
  font-size: 32px;
  color: var(--text-dark);
  margin-bottom: 15px;
}

.order-success-container p {
  color: var(--text);
  font-size: 16px;
  line-height: 1.6;
}

.order-success-buttons {
  margin-top: 30px;
}

.order-success-buttons a {
  background: var(--primary);
  color: var(--white);
  padding: 15px 30px;
  border-radius: 10px;
  font-weight: 700;
  display: inline-block;
}/* =========================================
   RESPONSIVE DESIGN (MOBILE & TABLET)
========================================= */

/* Tablet & Small Laptop (1024px এর নিচে) */
@media (max-width: 1024px) {
  .arai-hero-content h1 {
    font-size: 40px;
  }

  .arai-hero-container {
    gap: 20px;
  }

  .arai-navbar-inner {
    padding: 12px 15px;
  }
}

/* Mobile Devices (768px এর নিচে) */
@media (max-width: 768px) {
  /* Global Padding Fix */
  .restaurants-page-container,
  .restaurants,
  .categories,
  .checkout-container,
  .cart-page-container,
  .account-container,
  .menu-section,
  .restaurant-page {
    padding-left: 15px;
    padding-right: 15px;
  }

  /* Navbar */
  .arai-nav-links {
    display: none;
  }
  
  .arai-account-text {
    display: none;
  }
  
  .arai-account-button {
    padding: 8px 10px;
    font-size: 16px;
  }

  .arai-menu-button {
    display: block;
  }

  /* Hero Section Mobile */
  .arai-hero {
    padding: 40px 15px 60px;
  }

  .arai-hero-container {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .arai-hero-content h1 {
    font-size: 32px;
  }

  .arai-hero-description {
    margin: 0 auto 20px;
    font-size: 16px;
  }

  .arai-hero-search {
    flex-direction: row;
    margin: 0 auto 20px;
    padding: 8px;
  }

  .arai-hero-search input {
    font-size: 14px;
    padding: 8px;
  }

  .arai-hero-search button {
    padding: 10px 15px;
    font-size: 13px;
  }

  .arai-hero-features {
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
  }

  .arai-feature-divider {
    display: none;
  }

  /* Hide floating images on mobile to keep it clean */
  .arai-hero-visual {
    display: none;
  }

  /* Categories */
  .categories-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .categories-header h2 {
    font-size: 24px;
  }

  .category-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .category-card {
    padding: 15px 10px;
  }

  .category-icon {
    font-size: 30px;
  }

  .category-card h3 {
    font-size: 13px;
  }

  /* Restaurants Home Grid */
  .restaurants-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .restaurants-header h2 {
    font-size: 24px;
  }

  .restaurant-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .restaurant-card {
    border-radius: 10px;
  }

  .restaurant-image {
    height: 100px;
    font-size: 40px;
  }

  .restaurant-info {
    padding: 10px;
  }

  .restaurant-info h3 {
    font-size: 14px;
  }

  .restaurant-info p {
    font-size: 11px;
    margin-bottom: 5px;
  }

  .restaurant-meta {
    font-size: 11px;
    flex-direction: column;
    gap: 5px;
  }

  /* Offers Section Mobile */
  .offers {
    padding: 0 15px;
    margin: 30px auto;
  }

  .offers-content {
    flex-direction: column;
    text-align: center;
    padding: 30px 20px;
    gap: 20px;
  }

  .offers-text h2 {
    font-size: 24px;
  }

  .offer-visual {
    display: none;
  }

  /* Footer Mobile */
  .footer-content {
    grid-template-columns: 1fr;
    gap: 20px;
    text-align: center;
  }

  .footer-brand p {
    margin: 0 auto;
  }

  /* Restaurants Page Mobile */
  .restaurants-page-header h1 {
    font-size: 28px;
  }

  .restaurant-page-stats {
    flex-wrap: wrap;
    gap: 10px;
  }

  .restaurant-stat {
    padding: 10px 15px;
    flex: 1 1 40%;
  }

  .restaurant-stat strong {
    font-size: 18px;
  }

  .restaurant-controls {
    padding: 12px;
  }

  .restaurant-filter-row {
    gap: 6px;
  }

  .restaurant-filter {
    padding: 6px 12px;
    font-size: 12px;
  }

  .restaurant-sort {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  .restaurant-sort select {
    width: 100%;
  }

  .all-restaurants-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .restaurants-list-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  .restaurants-bottom-cta {
    flex-direction: column;
    text-align: center;
    gap: 15px;
    padding: 20px;
  }

  /* Restaurant Detail Page Mobile */
  .restaurant-page-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .restaurant-page-header h1 {
    font-size: 22px;
  }

  .food-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .food-card {
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  /* Cart Page Mobile */
  .cart-page-header h1 {
    font-size: 28px;
  }

  .cart-page-content {
    flex-direction: column;
  }

  /* Checkout Page Mobile */
  .checkout-content {
    grid-template-columns: 1fr;
  }

  .checkout-title h1 {
    font-size: 24px;
  }

  .checkout-back-button {
    margin-bottom: 10px;
  }

  /* Account Page Mobile */
  .account-header h1 {
    font-size: 24px;
  }

  .account-info-grid {
    grid-template-columns: 1fr;
  }

  .account-actions {
    flex-direction: column;
  }

  /* Login / Signup Mobile */
  .login-card {
    padding: 30px 20px;
  }
}

/* Very Small Mobile (480px এর নিচে) */
@media (max-width: 480px) {
  .arai-logo-text span {
    font-size: 15px;
  }

  .arai-logo-text small {
    font-size: 10px;
  }

  .arai-hero-badge {
    font-size: 12px;
    padding: 6px 12px;
  }

  .arai-hero-content h1 {
    font-size: 28px;
  }

  .arai-hero-search button {
    font-size: 12px;
    padding: 8px 12px;
  }

  .category-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .restaurant-grid {
    grid-template-columns: 1fr;
  }

  .restaurant-stat {
    flex: 1 1 100%;
  }
}/* =========================================
   ORDER TRACKING SYSTEM CSS
========================================= */
.order-tracking-section {
  margin-top: 30px;
  background: var(--primary-light);
  padding: 20px;
  border-radius: 15px;
}

.tracking-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  margin-bottom: 20px;
}

.tracking-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 80px;
}

.tracking-icon {
  width: 50px;
  height: 50px;
  background: var(--white);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-bottom: 10px;
  border: 3px solid var(--border);
  transition: all 0.3s ease;
}

.tracking-step.active .tracking-icon {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--white);
}

.tracking-text strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
}

.tracking-text small {
  font-size: 11px;
  color: var(--text);
}

.tracking-line {
  flex: 1;
  height: 4px;
  background: var(--border);
  margin: 0 10px;
  margin-bottom: 30px;
  transition: all 0.3s ease;
}

.tracking-line.active {
  background: var(--primary);
}

.tracking-status-text {
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  color: var(--primary);
  margin-top: 10px;
}@media (max-width: 600px) {
  .tracking-step {
    width: 60px;
  }
  
  .tracking-icon {
    width: 40px;
    height: 40px;
    font-size: 18px;
  }

  .tracking-text strong {
    font-size: 12px;
  }
  
  .tracking-text small {
    display: none;
  }
}/* =========================================
   DARK MODE CSS
========================================= */
.dark {
  --primary: #13a89e;
  --primary-dark: #0e7f78;
  --primary-light: #1a3a38;
  --text: #b0b7c3;
  --text-dark: #f3f4f6;
  --bg: #121212;
  --white: #1e1e1e;
  --border: #333333;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.5);
}

.dark body {
  background-color: var(--bg);
  color: var(--text);
}

.dark .arai-navbar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
}

.dark .arai-logo-text span,
.dark h1,
.dark h2,
.dark h3 {
  color: var(--text-dark);
}

.dark .arai-hero {
  background: linear-gradient(135deg, #1a3a38 0%, #121212 100%);
}

.dark .arai-hero-badge,
.dark .arai-main-food-card,
.dark .arai-floating-card,
.dark .arai-food-bubble {
  background: var(--white);
}

.dark .arai-hero-search {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .arai-hero-search input {
  color: var(--text-dark);
}

.dark .arai-nav-links a {
  color: var(--text);
}

.dark .arai-nav-links a:hover,
.dark .arai-nav-links a.active {
  color: var(--primary);
}

.dark .categories,
.dark .restaurants {
  background: transparent;
}

.dark .category-card,
.dark .restaurant-card,
.dark .restaurant-controls,
.dark .all-restaurant-card,
.dark .food-card,
.dark .checkout-card,
.dark .account-card,
.dark .cart-items-list,
.dark .cart-summary,
.dark .login-card,
.dark .order-success-container {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .category-card:hover,
.dark .restaurant-card:hover,
.dark .all-restaurant-card:hover {
  border-color: var(--primary);
}

.dark .restaurant-search,
.dark .form-group input,
.dark .form-group textarea,
.dark .restaurant-sort select {
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text-dark);
}

.dark .restaurant-filter {
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text);
}

.dark .restaurant-filter.active {
  background: var(--primary);
  color: var(--white);
  border-color: var(--primary);
}

.dark .offers {
  background: linear-gradient(135deg, #0e7f78 0%, #1a3a38 100%);
}

.dark .footer {
  background: #0a0a0a;
}

.dark .account-input-wrapper input,
.dark .account-textarea-wrapper textarea {
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text-dark);
}

.dark .otp-verification-card,
.dark .account-information-card,
.dark .summary-restaurant {
  background: var(--bg);
}

.dark .tracking-icon {
  background: var(--bg);
}/* =========================================
   DARK MODE - TEXT COLOR FIX (সব লেখা সাদা হবে)
========================================= */
.dark {
  --text: #e2e8f0; /* Normal text */
  --text-h: #ffffff; /* Headings */
}

/* ১. সব হেডিং, প্যারাগ্রাফ, লেবেল, বাটন, ইনপুটের টেক্সট সাদা করা */
.dark h1, .dark h2, .dark h3, .dark h4, .dark h5, .dark h6 {
  color: var(--text-h); /* সাদা */
}

.dark p, .dark span, .dark label, .dark strong, .dark small, .dark li, .dark a {
  color: var(--text); /* হালকা ধূসর-সাদা */
}

/* ২. Navbar এর লেখা */
.dark .arai-logo-text span {
  color: var(--text-h);
}

.dark .arai-logo-text small {
  color: var(--primary);
}

.dark .arai-nav-links a {
  color: var(--text);
}

.dark .arai-nav-links a:hover, 
.dark .arai-nav-links a.active {
  color: var(--primary);
}

/* ৩. Hero Section এর লেখা */
.dark .arai-hero-content h1 {
  color: var(--text-h);
}

.dark .arai-hero-content h1 span {
  color: var(--primary);
}

.dark .arai-hero-description,
.dark .arai-hero-feature small {
  color: var(--text);
}

.dark .arai-hero-feature strong {
  color: var(--text-h);
}

/* ৪. Categories, Restaurants, Offers এর লেখা */
.dark .categories-header h2,
.dark .restaurants-header h2,
.dark .restaurants-page-header h1,
.dark .restaurants-list-header h2,
.dark .restaurants-bottom-cta h2,
.dark .offers-text h2 {
  color: var(--text-h);
}

.dark .categories-header p,
.dark .restaurants-header p,
.dark .restaurants-page-header p,
.dark .restaurants-bottom-cta p,
.dark .offers-text p {
  color: var(--text);
}

.dark .section-label {
  color: var(--primary);
}

/* ৫. ইনপুট, টেক্সটএরিয়া, সিলেক্ট এর টেক্সট সাদা করা */
.dark input,
.dark textarea,
.dark select {
  color: var(--text-h) !important;
  background-color: #2d2d2d !important;
  border-color: #444 !important;
}

.dark input::placeholder,
.dark textarea::placeholder {
  color: #888;
}

/* ৬. কার্ডের ভেতরের লেখা (RestaurantCard, CategoryCard, FoodCard ইত্যাদি) */
.dark .category-card h3,
.dark .restaurant-info h3,
.dark .food-info h3,
.dark .all-restaurant-info h2,
.dark .summary-restaurant strong,
.dark .checkout-card-heading h2,
.dark .payment-option strong {
  color: var(--text-h);
}

.dark .restaurant-info p,
.dark .food-info p,
.dark .all-restaurant-info p,
.dark .checkout-card-heading p,
.dark .payment-option small,
.dark .summary-restaurant small {
  color: var(--text);
}

.dark .restaurant-meta,
.dark .all-restaurant-meta {
  color: var(--text-h);
}

/* ৭. Login, Signup, Account পেজের লেখা */
.dark .login-header h1,
.dark .account-header h1,
.dark .account-section-title h3,
.dark .account-info-content strong {
  color: var(--text-h);
}

.dark .login-header p,
.dark .account-header p,
.dark .account-section-title p,
.dark .account-info-content span,
.dark .otp-header p,
.dark .otp-security-note {
  color: var(--text);
}

/* ৮. Tracking ও Success পেজের লেখা */
.dark .order-success-container h1 {
  color: var(--text-h);
}

.dark .order-success-container p {
  color: var(--text);
}

.dark .tracking-text strong {
  color: var(--text-h);
}

.dark .tracking-text small {
  color: var(--text);
}

/* ৯. Footer এর লেখা সাদা করবো (Footer এ background black থাকায় সাদা হলেই দেখা যাবে) */
.dark .footer-brand h2,
.dark .footer-column h3 {
  color: var(--text-h);
}

.dark .footer-brand p,
.dark .footer-column a,
.dark .footer-bottom p {
  color: #b0b7c3;
}

.dark .footer-column a:hover {
  color: var(--primary);
}

/* ১০. যে বাটনগুলোর কালো টেক্সট ছিল (যেমন View All, Back) */
.dark .view-all,
.dark .account-home-button,
.dark .checkout-back-button,
.dark .restaurant-page-header button {
  color: var(--text-h) !important;
  background-color: #333 !important;
  border-color: #444 !important;
}/* =========================================
   FAVORITES BUTTON
========================================= */
.favorite-button {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(255, 255, 255, 0.9);
  border: none;
  border-radius: 50%;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  cursor: pointer;
  box-shadow: var(--shadow);
  z-index: 10;
  transition: transform 0.2s;
}

.favorite-button:hover {
  transform: scale(1.1);
}

.favorite-button.active {
  background: #fee2e2;
}

.dark .favorite-button {
  background: rgba(40, 40, 40, 0.9);
}

.dark .favorite-button.active {
  background: #450a0a;
}/* =========================================
   FAVORITES PAGE
========================================= */
.favorite-actions {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.remove-favorite-button {
  background: #fee2e2;
  color: #dc2626;
  border: none;
  padding: 10px;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
}

.dark .remove-favorite-button {
  background: #450a0a;
  color: #fecaca;
}/* =========================================
   RATINGS & REVIEWS CSS
========================================= */
.reviews-section {
  max-width: 800px;
  margin: 40px auto;
  padding: 0 20px;
}

.reviews-header {
  text-align: center;
  margin-bottom: 30px;
}

.reviews-header h2 {
  font-size: 28px;
  color: var(--text-dark);
  margin-bottom: 10px;
}

.reviews-header p {
  color: var(--text);
}

.review-form {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 15px;
  padding: 20px;
  margin-bottom: 30px;
  box-shadow: var(--shadow);
}

.rating-stars-input {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
}

.rating-stars-input span {
  font-weight: 600;
  color: var(--text-dark);
}

.star-input {
  display: flex;
  gap: 5px;
}

.star {
  background: transparent;
  border: none;
  font-size: 28px;
  color: #d1d5db;
  cursor: pointer;
  transition: color 0.2s;
}

.star.active {
  color: #f59e0b;
}

.review-form textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 15px;
  outline: none;
  font-size: 14px;
}

.review-form textarea:focus {
  border-color: var(--primary);
}

.submit-review-button {
  width: 100%;
  background: var(--primary);
  color: var(--white);
  border: none;
  padding: 12px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.no-reviews {
  text-align: center;
  color: var(--text);
  padding: 20px;
}

.review-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 15px;
  box-shadow: var(--shadow);
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.review-header strong {
  font-size: 16px;
  color: var(--text-dark);
}

.review-header small {
  font-size: 12px;
  color: var(--text);
}

.review-card p {
  line-height: 1.5;
}

/* Dark Mode Fix */
.dark .review-form,
.dark .review-card {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .review-form textarea {
  background: var(--bg);
  border: 1px solid var(--border);
  color: var(--text-dark);
}

.dark .star {
  color: #555;
}

.dark .star.active {
  color: #f59e0b;
}

.dark .rating-stars-input span,
.dark .review-header strong {
  color: var(--text-dark);
}

.dark .review-header small {
  color: var(--text);
}/* =========================================
   DELIVERY TIME PICKER CSS
========================================= */
.delivery-time-section {
  margin-bottom: 20px;
}

.checkout-icon-container {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 15px;
}

.checkout-icon-container h2 {
  font-size: 18px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.checkout-icon-container p {
  font-size: 12px;
  color: var(--text);
}

.delivery-time-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.delivery-time-option {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--border);
  padding: 15px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s;
}

.delivery-time-option:hover {
  border-color: var(--primary);
  background: var(--primary-light);
}

.delivery-time-option.selected {
  border-color: var(--primary);
  background: var(--primary-light);
}

.delivery-time-option input {
  accent-color: var(--primary);
}

.delivery-time-option strong {
  display: block;
  font-size: 14px;
  color: var(--text-dark);
  margin-bottom: 4px;
}

.delivery-time-option small {
  font-size: 12px;
  color: var(--text);
}

/* Dark Mode Fix */
.dark .delivery-time-option {
  border: 1px solid var(--border);
  background: var(--bg);
}

.dark .delivery-time-option.selected,
.dark .delivery-time-option:hover {
  border-color: var(--primary);
  background: var(--primary-light);
}

.dark .delivery-time-option strong {
  color: var(--text-dark);
}/* Categories Visibility Fix */
.categories {
  display: block;
  position: relative;
  z-index: 10;
  margin-top: 40px;
  padding: 0 20px;
}

.categories-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 20px;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 15px;
}

.category-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s;
}

.category-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
  border-color: var(--primary);
}

.category-icon {
  font-size: 40px;
  margin-bottom: 10px;
}

.category-card h3 {
  font-size: 16px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.category-card p {
  font-size: 12px;
  color: var(--text);
}/* Categories Visibility Fix */
.categories {
  display: block;
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 20px;
  position: relative;
  z-index: 10;
}

.categories-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 20px;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 15px;
}

.category-card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s;
  text-decoration: none;
}

.category-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow);
  border-color: var(--primary);
}

.category-icon {
  font-size: 40px;
  margin-bottom: 10px;
}

.category-card h3 {
  font-size: 16px;
  color: var(--text-dark);
  margin-bottom: 5px;
}

.category-card p {
  font-size: 12px;
  color: var(--text);
}/* =========================================
   DELIVERY STATS BANNER
========================================= */
.delivery-stats {
  max-width: 1200px;
  margin: 20px auto;
  padding: 0 20px;
  display: flex;
  gap: 20px;
  justify-content: center;
  flex-wrap: wrap;
}

.delivery-stat {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 15px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  max-width: 280px;
}

.delivery-stat-icon {
  font-size: 32px;
}

.delivery-stat strong {
  display: block;
  font-size: 16px;
  color: var(--text-dark);
  margin-bottom: 3px;
}

.delivery-stat small {
  font-size: 12px;
  color: var(--text);
}

.dark .delivery-stat {
  background: var(--white);
  border: 1px solid var(--border);
}

.dark .delivery-stat strong {
  color: var(--text-dark);
}

@media (max-width: 768px) {
  .delivery-stats {
    flex-direction: column;
    align-items: center;
  }

  .delivery-stat {
    width: 100%;
    max-width: 100%;
  }
}/* =========================================
   AUTO-FILL ADDRESS CSS (Optional)
========================================= */
